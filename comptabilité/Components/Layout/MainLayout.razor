@inherits LayoutComponentBase
@using comptabilité.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject BreadcrumbState BreadcrumbState
@implements IDisposable

<button type="button" class="skip-link" onclick="document.getElementById('main-content').focus()">Aller au contenu principal</button>

<div class="page">
    <header class="app-header">
        <div class="app-header-brand">
            <a class="navbar-brand" href=""><img class="brand-mark" src="favicon.svg?v=2" alt="" />NEXFLUX</a>
        </div>

        <div class="app-header-main">
            <nav class="app-breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    @for (var i = 0; i < crumbs.Count; i++)
                    {
                        var crumb = crumbs[i];
                        var isLast = i == crumbs.Count - 1;
                        <li>
                            @if (isLast || crumb.Href is null)
                            {
                                <span aria-current="@(isLast ? "page" : null)">@crumb.Label</span>
                            }
                            else
                            {
                                <a href="@crumb.Href">@crumb.Label</a>
                            }
                        </li>
                    }
                </ol>
            </nav>

            @if (AuthService.EstConnecte())
            {
                <button type="button" class="btn btn-outline-primary btn-sm app-header-logout" onclick="window.performLogout(); return false;" title="Se déconnecter" aria-label="Se déconnecter">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                </button>
            }
        </div>
    </header>

    <aside class="sidebar">
        <NavMenu />

        @if (AuthService.EstConnecte())
        {
            <div class="sidebar-user">
                <div class="sidebar-user-avatar" aria-hidden="true">@UserInitial</div>
                <div class="sidebar-user-info">
                    <span class="sidebar-user-label">Connecté</span>
                    <span class="sidebar-user-name">@userName</span>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.performLogout(); return false;" title="Se déconnecter" aria-label="Se déconnecter">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        }
    </aside>

    <main id="main-content" tabindex="-1">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private sealed record Crumb(string Label, string? Href);

    private static readonly Dictionary<string, string> SectionLabels = new(StringComparer.OrdinalIgnoreCase)
    {
        ["transactions"] = "Transactions",
        ["clients"] = "Clients",
        ["reservations"] = "Réservations",
        ["postes"] = "Postes",
        ["voitures"] = "Voitures",
        ["graphiques"] = "Graphiques",
        ["error"] = "Erreur"
    };

    private string? userName;
    private List<Crumb> crumbs = new();

    private string UserInitial =>
        string.IsNullOrWhiteSpace(userName) ? "?" : userName.Trim()[0].ToString().ToUpperInvariant();

    protected override void OnInitialized()
    {
        Refresh();
        NavigationManager.LocationChanged += OnLocationChanged;
        BreadcrumbState.Changed += OnBreadcrumbChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Refresh();
        StateHasChanged();
    }

    private void OnBreadcrumbChanged()
    {
        _ = InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    private void Refresh()
    {
        userName = AuthService.EstConnecte() ? AuthService.GetUtilisateurNom() : null;
        crumbs = BuildCrumbs();
    }

    private List<Crumb> BuildCrumbs()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var cut = relative.IndexOfAny(new[] { '?', '#' });
        if (cut >= 0)
        {
            relative = relative[..cut];
        }

        var segments = relative.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length == 0)
        {
            return new List<Crumb> { new("Accueil", null) };
        }

        var section = segments[0];
        var label = SectionLabels.TryGetValue(section, out var known)
            ? known
            : char.ToUpperInvariant(section[0]) + section[1..];

        var list = new List<Crumb>
        {
            new("Accueil", ""),
            new(label, segments.Length > 1 ? section : null)
        };

        if (segments.Length > 1)
        {
            var detailLabel = int.TryParse(segments[1], out _)
                ? (string.Equals(BreadcrumbState.Section, section, StringComparison.OrdinalIgnoreCase)
                    && !string.IsNullOrWhiteSpace(BreadcrumbState.DetailLabel)
                        ? BreadcrumbState.DetailLabel!
                        : "Détail")
                : segments[1];
            list.Add(new Crumb(detailLabel, null));
        }

        return list;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        BreadcrumbState.Changed -= OnBreadcrumbChanged;
    }
}
