@inherits LayoutComponentBase
@using comptabilité.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <a class="navbar-brand" href="">NEXFLUX</a>
                <div class="d-flex align-items-center gap-3">
                    @if (AuthService.EstConnecte())
                    {
                        <span class="text-secondary">@userName</span>
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.performLogout(); return false;">
                            <span class="bi bi-box-arrow-right me-1"></span> Déconnexion
                        </button>
                    }
                </div>
            </div>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private string? userName;

    protected override void OnInitialized()
    {
        UpdateUserName();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateUserName();
        StateHasChanged();
    }

    private void UpdateUserName()
    {
        if (AuthService.EstConnecte())
        {
            userName = AuthService.GetUtilisateurNom();
        }
        else
        {
            userName = null;
        }
    }

    // La déconnexion est maintenant gérée entièrement par JavaScript (window.performLogout)
    // Cette méthode n'est plus utilisée mais conservée au cas où

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
