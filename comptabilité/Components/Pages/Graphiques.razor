@page "/graphiques"
@using comptabilité.Models
@using comptabilité.Data
@using comptabilité.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@inject IServiceScopeFactory ServiceScopeFactory
@inject IJSRuntime JSRuntime
@inject AuthService AuthService
@rendermode InteractiveServer

<PageTitle>Graphiques - Dépenses et Gains</PageTitle>

<div class="container mt-4 gr-page">
    <div class="gr-header">
        <div>
            <h2 class="gr-title">Graphiques</h2>
            <p class="gr-subtitle">@PeriodDescription</p>
        </div>
        <span class="gr-live" role="status" aria-live="polite">
            @if (isGenerating)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Mise à jour…</span>
            }
            else
            {
                <i class="bi bi-check-circle" aria-hidden="true"></i>
                <span>À jour</span>
            }
        </span>
    </div>

    <!-- Synthèse de la sélection -->
    <div class="gr-kpis">
        <div class="gr-kpi gr-kpi--expense">
            <span class="gr-kpi-label">Dépenses</span>
            <span class="gr-kpi-value">@SignedMontant(TotalDepenses, '-')</span>
        </div>
        <div class="gr-kpi gr-kpi--income">
            <span class="gr-kpi-label">Gains</span>
            <span class="gr-kpi-value">@SignedMontant(TotalGains, '+')</span>
        </div>
        <div class="gr-kpi @(Solde >= 0 ? "gr-kpi--income" : "gr-kpi--expense")">
            <span class="gr-kpi-label">Solde net</span>
            <span class="gr-kpi-value">@SignedMontant(Math.Abs(Solde), Solde >= 0 ? '+' : '-')</span>
        </div>
    </div>

    <!-- Filtres -->
    <div class="gr-toolbar">
        <div class="gr-field">
            <span class="gr-field-label" id="gr-mode-label">Regrouper</span>
            <div class="gr-segmented" role="group" aria-labelledby="gr-mode-label">
                <button type="button" class="@Seg(viewMode == "Poste")" aria-pressed="@(viewMode == "Poste")" @onclick='() => SetMode("Poste")'>Par poste</button>
                <button type="button" class="@Seg(viewMode == "Voiture")" aria-pressed="@(viewMode == "Voiture")" @onclick='() => SetMode("Voiture")'>Par voiture</button>
            </div>
        </div>

        <div class="gr-field">
            <label for="graphiques-champ-2" class="gr-field-label">@(viewMode == "Poste" ? "Poste" : "Voiture")</label>
            <select id="graphiques-champ-2" class="form-select" value="@SelectedCategoryId" @onchange="OnCategoryChanged">
                <option value="">@(viewMode == "Poste" ? "Tous les postes" : "Toutes les voitures")</option>
                @if (viewMode == "Poste")
                {
                    foreach (var poste in postes)
                    {
                        <option value="@poste.Id">@poste.Nom</option>
                    }
                }
                else
                {
                    foreach (var voiture in voitures)
                    {
                        <option value="@voiture.Id">@voiture.Nom</option>
                    }
                }
            </select>
        </div>

        <div class="gr-field">
            <span class="gr-field-label" id="gr-period-label">Période</span>
            <div class="gr-segmented" role="group" aria-labelledby="gr-period-label">
                <button type="button" class="@Seg(activePreset == "tout")" aria-pressed="@(activePreset == "tout")" @onclick='() => ApplyPreset("tout")'>Tout</button>
                <button type="button" class="@Seg(activePreset == "annee")" aria-pressed="@(activePreset == "annee")" @onclick='() => ApplyPreset("annee")'>Cette année</button>
                <button type="button" class="@Seg(activePreset == "12m")" aria-pressed="@(activePreset == "12m")" @onclick='() => ApplyPreset("12m")'>12 mois</button>
            </div>
        </div>

        <div class="gr-field gr-field--dates">
            <label for="graphiques-champ-3" class="gr-field-label">Du</label>
            <InputDate id="graphiques-champ-3" class="form-control" @bind-Value="dateDebut" @bind-Value:after="OnDatesChanged" />
        </div>
        <div class="gr-field gr-field--dates">
            <label for="graphiques-champ-4" class="gr-field-label">Au</label>
            <InputDate id="graphiques-champ-4" class="form-control" @bind-Value="dateFin" @bind-Value:after="OnDatesChanged" />
        </div>
        <div class="gr-break" aria-hidden="true"></div>

        <div class="gr-field">
            <span class="gr-field-label" id="gr-gran-label">Découpage</span>
            <div class="gr-segmented" role="group" aria-labelledby="gr-gran-label">
                <button type="button" class="@Seg(groupByMonth)" aria-pressed="@groupByMonth" @onclick="() => SetGranularity(true)">Par mois</button>
                <button type="button" class="@Seg(!groupByMonth)" aria-pressed="@(!groupByMonth)" @onclick="() => SetGranularity(false)">Par jour</button>
            </div>
        </div>

        <div class="gr-field">
            <span class="gr-field-label" id="gr-curves-label">Courbes</span>
            <div class="gr-segmented" role="group" aria-labelledby="gr-curves-label">
                <button type="button" class="@Seg(CurveMode == "categorie")" aria-pressed="@(CurveMode == "categorie")" @onclick='() => SetCurves("categorie")'>Par @(viewMode == "Poste" ? "poste" : "voiture")</button>
                <button type="button" class="@Seg(CurveMode == "global")" aria-pressed="@(CurveMode == "global")" @onclick='() => SetCurves("global")'>Solde global</button>
                <button type="button" class="@Seg(CurveMode == "cumul")" aria-pressed="@(CurveMode == "cumul")" @onclick='() => SetCurves("cumul")'>Solde cumulé</button>
            </div>
        </div>
    </div>

    <div class="gr-layout">
        <!-- Graphique -->
        <section class="gr-card" aria-labelledby="gr-chart-title">
            <div class="gr-card-head">
                <h3 id="gr-chart-title" class="gr-card-title">@ChartTitle</h3>
                <span class="gr-badge">@(groupByMonth ? "Par mois" : "Par jour")</span>
            </div>
            <div class="gr-chart">
                <canvas id="depensesChart" aria-label="@ChartTitle" role="img"></canvas>
                @if (isGenerating && !chartData.Any())
                {
                    <div class="gr-overlay" role="status">
                        <div class="spinner-border text-primary" aria-hidden="true"></div>
                        <p>Chargement des données…</p>
                    </div>
                }
                else if (!isGenerating && hasLoaded && !chartData.Any())
                {
                    <div class="gr-overlay">
                        <i class="bi bi-graph-up" aria-hidden="true"></i>
                        <p class="gr-overlay-title">Aucune donnée sur cette sélection</p>
                        <p>Modifiez la période ou le @(viewMode == "Poste" ? "poste" : "véhicule") sélectionné.</p>
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">@errorMessage</div>
            }
        </section>

        <!-- Répartition -->
        <aside class="gr-card" aria-labelledby="gr-split-title">
            <div class="gr-card-head">
                <h3 id="gr-split-title" class="gr-card-title">Dépenses par @(viewMode == "Poste" ? "poste" : "voiture")</h3>
            </div>
            @if (Repartition.Any())
            {
                <ul class="gr-split">
                    @foreach (var ligne in Repartition)
                    {
                        <li>
                            <div class="gr-split-row">
                                <span class="gr-split-name" title="@ligne.Nom">@ligne.Nom</span>
                                <span class="gr-split-amount">@FormatMontant(ligne.Montant)</span>
                            </div>
                            <div class="gr-split-track" role="img" aria-label="@ligne.Part.ToString("0") % des dépenses">
                                <span class="gr-split-bar" style="width:@BarWidth(ligne.Part)%"></span>
                            </div>
                            <small class="gr-split-share">@ligne.Part.ToString("0.#", Fr) %</small>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="gr-split-empty">Aucune dépense sur cette sélection.</p>
            }
        </aside>
    </div>
</div>

@code {
    private List<Voiture> voitures = new();
    private List<Poste> postes = new();
    private string viewMode = "Poste";
    private int? selectedVoitureId;
    private int? selectedPosteId;
    private DateTime dateDebut = new DateTime(2023, 8, 1);
    private DateTime dateFin = DateTime.Now;
    private bool groupByMonth = true;
    private bool showSoldeGlobal = false;
    private bool soldeCumulatif = false;
    private List<ChartDataPoint> chartData = new();

    private bool isChartInitialized = false;
    private bool needsChartUpdate = false;
    private bool isGenerating = false;
    private bool hasLoaded = false;
    private bool refreshQueued = false;
    private string activePreset = "tout";
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadVoitures();
        await LoadPostes();
        // Ne pas charger les données automatiquement, attendre le clic sur le bouton
    }

    private async Task LoadPostes()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            postes = new List<Poste>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        postes = await db.Postes
            .Where(p => p.UtilisateurId == userId.Value)
            .OrderBy(p => p.Nom)
            .ToListAsync();
    }

    private async Task LoadVoitures()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            voitures = new List<Voiture>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        voitures = await db.Voitures
            .Where(v => v.UtilisateurId == userId.Value)
            .OrderBy(v => v.Nom)
            .ToListAsync();
    }

    private static readonly System.Globalization.CultureInfo Fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");

    private sealed record LigneRepartition(string Nom, decimal Montant, decimal Part);

    private string SelectedCategoryId => (viewMode == "Poste" ? selectedPosteId : selectedVoitureId)?.ToString() ?? string.Empty;

    private string CurveMode => !showSoldeGlobal ? "categorie" : soldeCumulatif ? "cumul" : "global";

    private decimal TotalDepenses => -chartData.Where(d => d.Montant < 0).Sum(d => d.Montant);

    private decimal TotalGains => chartData.Where(d => d.Montant > 0).Sum(d => d.Montant);

    private decimal Solde => TotalGains - TotalDepenses;

    private string ChartTitle => CurveMode switch
    {
        "global" => "Solde net global (gains − dépenses)",
        "cumul" => "Solde net cumulé (gains − dépenses)",
        _ => $"Solde net par {(viewMode == "Poste" ? "poste" : "voiture")} (gains − dépenses)"
    };

    private string PeriodDescription
    {
        get
        {
            var debut = dateDebut == default ? "le début" : dateDebut.ToString("dd/MM/yyyy");
            var fin = dateFin == default ? "aujourd'hui" : dateFin.ToString("dd/MM/yyyy");
            return $"{(viewMode == "Poste" ? "Par poste" : "Par voiture")} · du {debut} au {fin}";
        }
    }

    private IReadOnlyList<LigneRepartition> Repartition
    {
        get
        {
            var total = TotalDepenses;
            return chartData
                .Where(d => d.Montant < 0)
                .GroupBy(d => d.Categorie)
                .Select(g => new { Nom = g.Key, Montant = -g.Sum(d => d.Montant) })
                .OrderByDescending(x => x.Montant)
                .Select(x => new LigneRepartition(x.Nom, x.Montant, total > 0 ? x.Montant / total * 100m : 0m))
                .ToList();
        }
    }

    private static string Seg(bool actif) => actif ? "gr-segment is-active" : "gr-segment";

    private static string FormatMontant(decimal montant) => $"{montant.ToString("N2", Fr)} €";

    private static string SignedMontant(decimal montant, char signe) => montant == 0 ? FormatMontant(0) : signe + FormatMontant(montant);

    private static string BarWidth(decimal part)
        => Math.Round(Math.Min(100m, part), 1).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private async Task SetMode(string mode)
    {
        if (viewMode == mode)
        {
            return;
        }

        viewMode = mode;
        selectedPosteId = null;
        selectedVoitureId = null;
        await RefreshAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        int? id = int.TryParse(e.Value?.ToString(), out var valeur) ? valeur : null;
        if (viewMode == "Poste")
        {
            selectedPosteId = id;
        }
        else
        {
            selectedVoitureId = id;
        }

        await RefreshAsync();
    }

    private async Task ApplyPreset(string preset)
    {
        activePreset = preset;
        var aujourdhui = DateTime.Today;
        switch (preset)
        {
            case "annee":
                dateDebut = new DateTime(aujourdhui.Year, 1, 1);
                dateFin = aujourdhui;
                break;
            case "12m":
                dateDebut = aujourdhui.AddMonths(-12);
                dateFin = aujourdhui;
                break;
            default:
                dateDebut = new DateTime(2023, 8, 1);
                dateFin = aujourdhui;
                break;
        }

        await RefreshAsync();
    }

    private async Task OnDatesChanged()
    {
        activePreset = "perso";
        await RefreshAsync();
    }

    private async Task SetGranularity(bool parMois)
    {
        if (groupByMonth == parMois)
        {
            return;
        }

        groupByMonth = parMois;
        await RefreshAsync();
    }

    private async Task SetCurves(string mode)
    {
        showSoldeGlobal = mode != "categorie";
        soldeCumulatif = mode == "cumul";
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (!isChartInitialized)
        {
            return;
        }

        if (isGenerating)
        {
            refreshQueued = true;
            return;
        }

        await GenerateChart();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Le canvas est toujours présent : on initialise le graphique puis on charge les données
            await Task.Delay(200);
            await InitializeChart();
            isChartInitialized = true;
            await GenerateChart();
            return;
        }

        if (isChartInitialized && needsChartUpdate)
        {
            needsChartUpdate = false;
            await Task.Delay(50); // laisse le temps au canvas d'être prêt
            await UpdateChart();
            isGenerating = false;
            hasLoaded = true;

            if (refreshQueued)
            {
                refreshQueued = false;
                await GenerateChart();
            }
            else
            {
                StateHasChanged();
            }
        }
    }

    private async Task GenerateChart()
    {
        isGenerating = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            await LoadChartData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement : {ex.Message}";
            isGenerating = false;
            hasLoaded = true;
            StateHasChanged();
        }
    }

    private async Task LoadChartData()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            chartData = new List<ChartDataPoint>();
            needsChartUpdate = true;
            StateHasChanged();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        var query = db.Transactions
            .Where(t => t.UtilisateurId == userId.Value)
            .Include(t => t.Voiture)
            .Include(t => t.Poste)
            .AsQueryable();

        // Filtres selon le mode d'affichage
        if (viewMode == "Poste")
        {
            // Pour les dépenses, on filtre par poste
            query = query.Where(t => t.Type == "Dépense" && t.PosteId != null);
            
            if (selectedPosteId.HasValue)
            {
                query = query.Where(t => t.PosteId == selectedPosteId);
            }
        }
        else if (viewMode == "Voiture")
        {
            // Pour les voitures, on prend les dépenses avec voiture
            query = query.Where(t => t.Type == "Dépense" && t.VoitureId != null);
            
            if (selectedVoitureId.HasValue)
            {
                query = query.Where(t => t.VoitureId == selectedVoitureId);
            }
        }

        // Filtres de date
        if (dateDebut != default)
        {
            query = query.Where(t => t.Date >= dateDebut);
        }

        if (dateFin != default)
        {
            query = query.Where(t => t.Date < dateFin.Date.AddDays(1));
        }

        var transactions = await query.OrderBy(t => t.Date).ToListAsync();

        // Ajouter aussi les gains pour avoir le solde complet
        var gainsQuery = db.Transactions
            .Where(t => t.UtilisateurId == userId.Value)
            .Include(t => t.Client)
            .Include(t => t.Voiture)
            .Include(t => t.Poste)
            .Where(t => t.Type == "Gain");

        // Appliquer le filtre par poste si un poste est sélectionné
        if (viewMode == "Poste" && selectedPosteId.HasValue)
        {
            gainsQuery = gainsQuery.Where(t => t.PosteId == selectedPosteId);
        }

        // Appliquer le filtre par voiture si une voiture est sélectionnée
        if (viewMode == "Voiture" && selectedVoitureId.HasValue)
        {
            gainsQuery = gainsQuery.Where(t => t.VoitureId == selectedVoitureId);
        }

        if (dateDebut != default)
        {
            gainsQuery = gainsQuery.Where(t => t.Date >= dateDebut);
        }

        if (dateFin != default)
        {
            gainsQuery = gainsQuery.Where(t => t.Date < dateFin.Date.AddDays(1));
        }

        var gains = await gainsQuery.OrderBy(t => t.Date).ToListAsync();

        // Combiner et grouper selon le mode
        if (groupByMonth)
        {
            if (viewMode == "Poste")
            {
                // Grouper par poste et mois
                var depensesGrouped = transactions
                    .GroupBy(t => new { Year = t.Date.Year, Month = t.Date.Month, Poste = t.Poste!.Nom })
                    .Select(g => new ChartDataPoint
                    {
                        Label = $"{GetMonthName(g.Key.Month)} {g.Key.Year}",
                        Categorie = g.Key.Poste,
                        Montant = -g.Sum(t => t.Montant), // Négatif pour les dépenses
                        Date = new DateTime(g.Key.Year, g.Key.Month, 1)
                    });

                // Grouper les gains par poste et mois (ou "Gains généraux" si pas de poste)
                var gainsGrouped = gains
                    .GroupBy(t => new { Year = t.Date.Year, Month = t.Date.Month, Poste = t.Poste != null ? t.Poste.Nom : "Gains généraux" })
                    .Select(g => new ChartDataPoint
                    {
                        Label = $"{GetMonthName(g.Key.Month)} {g.Key.Year}",
                        Categorie = g.Key.Poste,
                        Montant = g.Sum(t => t.Montant), // Positif pour les gains
                        Date = new DateTime(g.Key.Year, g.Key.Month, 1)
                    });

                chartData = depensesGrouped.Concat(gainsGrouped)
                    .OrderBy(d => d.Date)
                    .ThenBy(d => d.Categorie)
                    .ToList();
            }
            else
            {
                // Grouper par voiture et mois
                var depensesGrouped = transactions
                    .GroupBy(t => new { Year = t.Date.Year, Month = t.Date.Month, Voiture = t.Voiture!.Nom })
                    .Select(g => new ChartDataPoint
                    {
                        Label = $"{GetMonthName(g.Key.Month)} {g.Key.Year}",
                        Categorie = g.Key.Voiture,
                        Montant = -g.Sum(t => t.Montant), // Négatif pour les dépenses
                        Date = new DateTime(g.Key.Year, g.Key.Month, 1)
                    });

                // Grouper les gains par voiture et mois (gains sans voiture = "Gains généraux")
                var gainsGrouped = gains
                    .GroupBy(t => new { Year = t.Date.Year, Month = t.Date.Month, Voiture = t.Voiture != null ? t.Voiture.Nom : "Gains généraux" })
                    .Select(g => new ChartDataPoint
                    {
                        Label = $"{GetMonthName(g.Key.Month)} {g.Key.Year}",
                        Categorie = g.Key.Voiture,
                        Montant = g.Sum(t => t.Montant), // Positif pour les gains
                        Date = new DateTime(g.Key.Year, g.Key.Month, 1)
                    });

                chartData = depensesGrouped.Concat(gainsGrouped)
                    .OrderBy(d => d.Date)
                    .ThenBy(d => d.Categorie)
                    .ToList();
            }
        }
        else
        {
            if (viewMode == "Poste")
            {
                var depensesGrouped = transactions
                    .GroupBy(t => new { Date = t.Date.Date, Poste = t.Poste!.Nom })
                    .Select(g => new ChartDataPoint
                    {
                        Label = g.Key.Date.ToString("dd/MM/yyyy"),
                        Categorie = g.Key.Poste,
                        Montant = -g.Sum(t => t.Montant),
                        Date = g.Key.Date
                    });

                // Grouper les gains par poste et date (ou "Gains généraux" si pas de poste)
                var gainsGrouped = gains
                    .GroupBy(t => new { Date = t.Date.Date, Poste = t.Poste != null ? t.Poste.Nom : "Gains généraux" })
                    .Select(g => new ChartDataPoint
                    {
                        Label = g.Key.Date.ToString("dd/MM/yyyy"),
                        Categorie = g.Key.Poste,
                        Montant = g.Sum(t => t.Montant),
                        Date = g.Key.Date
                    });

                chartData = depensesGrouped.Concat(gainsGrouped)
                    .OrderBy(d => d.Date)
                    .ThenBy(d => d.Categorie)
                    .ToList();
            }
            else
            {
                var depensesGrouped = transactions
                    .GroupBy(t => new { Date = t.Date.Date, Voiture = t.Voiture!.Nom })
                    .Select(g => new ChartDataPoint
                    {
                        Label = g.Key.Date.ToString("dd/MM/yyyy"),
                        Categorie = g.Key.Voiture,
                        Montant = -g.Sum(t => t.Montant),
                        Date = g.Key.Date
                    });

                // Grouper les gains par voiture et date (gains sans voiture = "Gains généraux")
                var gainsGrouped = gains
                    .GroupBy(t => new { Date = t.Date.Date, Voiture = t.Voiture != null ? t.Voiture.Nom : "Gains généraux" })
                    .Select(g => new ChartDataPoint
                    {
                        Label = g.Key.Date.ToString("dd/MM/yyyy"),
                        Categorie = g.Key.Voiture,
                        Montant = g.Sum(t => t.Montant),
                        Date = g.Key.Date
                    });

                chartData = depensesGrouped.Concat(gainsGrouped)
                    .OrderBy(d => d.Date)
                    .ThenBy(d => d.Categorie)
                    .ToList();
            }
        }

        // Marquer que le graphique doit être mis à jour
        needsChartUpdate = true;
        StateHasChanged();
    }

    private async Task InitializeChart()
    {
        try
        {
            // Vérifier que Chart.js est chargé
            var chartJsLoaded = await JSRuntime.InvokeAsync<bool>("eval", "typeof Chart !== 'undefined'");
            if (!chartJsLoaded)
            {
                Console.WriteLine("Chart.js n'est pas chargé - attente du chargement...");
                // Attendre un peu et réessayer
                await Task.Delay(500);
                chartJsLoaded = await JSRuntime.InvokeAsync<bool>("eval", "typeof Chart !== 'undefined'");
                if (!chartJsLoaded)
                {
                    Console.WriteLine("Chart.js n'est toujours pas chargé après l'attente");
                    return;
                }
            }

            await JSRuntime.InvokeVoidAsync("initializeDepensesChart");
            Console.WriteLine("Graphique initialisé");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Erreur JS: {ex.Message}");
        }
        catch (InvalidOperationException ex)
        {
            Console.WriteLine($"Erreur opération: {ex.Message}");
        }
    }

    private async Task UpdateChart()
    {
        if (!chartData.Any())
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("updateDepensesChart", Array.Empty<string>(), Array.Empty<object>());
            }
            catch (JSException ex)
            {
                Console.WriteLine($"Erreur JS lors de la remise à zéro: {ex.Message}");
            }

            return;
        }

        try
        {
            // Obtenir toutes les dates uniques pour les labels, triées par date
            var labels = chartData
                .GroupBy(d => d.Label)
                .Select(g => new { Label = g.Key, Date = g.First().Date })
                .OrderBy(x => x.Date)
                .Select(x => x.Label)
                .ToArray();

            var datasets = new List<object>();

            // Si l'option "Afficher le solde global" est activée, on affiche uniquement le solde global
            if (showSoldeGlobal)
            {
                var soldePoints = new List<decimal>();

                if (soldeCumulatif)
                {
                    // Mode cumulatif : additionner progressivement
                    decimal soldeCumulatif = 0;
                    foreach (var label in labels)
                    {
                        // Pour chaque date, additionner tous les montants (gains + dépenses)
                        var soldePeriode = chartData
                            .Where(d => d.Label == label)
                            .Sum(d => d.Montant);
                        
                        // Ajouter au solde cumulatif
                        soldeCumulatif += soldePeriode;
                        soldePoints.Add(soldeCumulatif);
                    }

                    datasets.Add(new
                    {
                        label = "Solde Global Cumulatif",
                        data = soldePoints.ToArray()
                    });
                }
                else
                {
                    // Mode par période : solde de chaque période (comme les autres courbes)
                    foreach (var label in labels)
                    {
                        // Pour chaque date, additionner tous les montants (gains + dépenses)
                        var solde = chartData
                            .Where(d => d.Label == label)
                            .Sum(d => d.Montant);
                        
                        soldePoints.Add(solde);
                    }

                    datasets.Add(new
                    {
                        label = "Solde Global",
                        data = soldePoints.ToArray()
                    });
                }
            }
            else
            {
                // Mode normal : afficher les courbes par catégorie
                // Obtenir toutes les catégories sauf "Gains" (on va les intégrer dans chaque catégorie)
                var categories = chartData
                    .Where(d => d.Categorie != "Gains")
                    .Select(d => d.Categorie)
                    .Distinct()
                    .ToList();

                // Pour chaque catégorie (voiture ou poste), calculer son solde net
                foreach (var categorie in categories)
            {
                var soldePoints = new List<decimal>();

                foreach (var label in labels)
                {
                    // Calculer le solde net pour cette catégorie à cette date
                    // Dépenses négatives pour cette catégorie + gains positifs (on prend une partie proportionnelle des gains)
                    var depenses = chartData
                        .Where(d => d.Label == label && d.Categorie == categorie)
                        .Sum(d => d.Montant); // Déjà négatif

                    // Calculer les gains totaux pour cette date
                    var gainsTotaux = chartData
                        .Where(d => d.Label == label && d.Categorie == "Gains")
                        .Sum(d => d.Montant); // Positif

                    // Calculer les dépenses totales pour cette date (toutes catégories)
                    var depensesTotales = chartData
                        .Where(d => d.Label == label && d.Categorie != "Gains")
                        .Sum(d => Math.Abs(d.Montant)); // Valeur absolue car déjà négatif

                    // Répartir les gains proportionnellement selon les dépenses de cette catégorie
                    decimal partGains = 0;
                    if (depensesTotales > 0)
                    {
                        var partDepensesCategorie = Math.Abs(depenses);
                        partGains = gainsTotaux * (partDepensesCategorie / depensesTotales);
                    }
                    else if (gainsTotaux > 0 && categories.Count == 1)
                    {
                        // Si une seule catégorie, lui attribuer tous les gains
                        partGains = gainsTotaux;
                    }

                    // Solde net = dépenses (négatif) + part des gains (positif)
                    var solde = depenses + partGains;
                    soldePoints.Add(solde);
                }

                datasets.Add(new
                {
                    label = $"{categorie} (Solde Net)",
                    data = soldePoints.ToArray()
                });
            }

            // S'il n'y a pas de catégories spécifiques mais qu'il y a des gains, créer une courbe globale
            if (!categories.Any() && chartData.Any(d => d.Categorie == "Gains"))
            {
                var soldePoints = new List<decimal>();
                foreach (var label in labels)
                {
                    var solde = chartData
                        .Where(d => d.Label == label)
                        .Sum(d => d.Montant);
                    soldePoints.Add(solde);
                }
                datasets.Add(new
                {
                    label = "Solde Net Global",
                    data = soldePoints.ToArray()
                });
            }
            }

            Console.WriteLine($"Mise à jour du graphique avec {labels.Length} labels et {datasets.Count} datasets (solde net par catégorie)");
            await JSRuntime.InvokeVoidAsync("updateDepensesChart", labels, datasets.ToArray());
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Erreur JS lors de la mise à jour: {ex.Message}");
        }
        catch (InvalidOperationException ex)
        {
            Console.WriteLine($"Erreur opération lors de la mise à jour: {ex.Message}");
        }
    }

    private string GetMonthName(int month)
    {
        return new DateTime(2000, month, 1).ToString("MMMM", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));
    }

    private class ChartDataPoint
    {
        public string Label { get; set; } = string.Empty;
        public string Categorie { get; set; } = string.Empty; // Peut être un poste, une voiture, ou "Gains"
        public decimal Montant { get; set; } // Négatif pour dépenses, positif pour gains
        public DateTime Date { get; set; }
    }
}

