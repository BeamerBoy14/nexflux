@page "/transactions"
@using comptabilité.Models
@using comptabilité.Data
@using comptabilité.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System
@using System.Linq
@using System.Globalization
@inject IServiceScopeFactory ServiceScopeFactory
@inject IJSRuntime JSRuntime
@inject AuthService AuthService
@rendermode InteractiveServer

<PageTitle>Transactions - Récapitulatif des dépenses</PageTitle>

<div class="container mt-4 tx-page">
    <div class="tx-header">
        <div>
            <h2 class="tx-title">Dépenses et gains</h2>
            <p class="tx-subtitle">@PeriodLabel</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="ShowAddTransactionModal">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> Ajouter une transaction
        </button>
    </div>

    <!-- Synthèse de la période -->
    <div class="tx-kpis">
        <div class="tx-kpi tx-kpi--expense">
            <span class="tx-kpi-label">Dépenses</span>
            <span class="tx-kpi-value">@SignedMontant(TotalDepensesPeriode, '-')</span>
        </div>
        <div class="tx-kpi tx-kpi--income">
            <span class="tx-kpi-label">Gains</span>
            <span class="tx-kpi-value">@SignedMontant(TotalGainsPeriode, '+')</span>
        </div>
        <div class="tx-kpi @(SoldePeriode >= 0 ? "tx-kpi--income" : "tx-kpi--expense")">
            <span class="tx-kpi-label">Solde</span>
            <span class="tx-kpi-value">@SignedMontant(Math.Abs(SoldePeriode), SoldePeriode >= 0 ? '+' : '-')</span>
        </div>
    </div>

    <!-- Filtres -->
    <div class="tx-toolbar">
        <div class="tx-field">
            <label for="transactions-champ-1" class="tx-field-label">Année</label>
            <select id="transactions-champ-1" class="form-select" @bind="selectedYear" @bind:after="OnFilterChanged">
                <option value="0">Toutes les années</option>
                @foreach (var year in availableYears.OrderByDescending(y => y))
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>

        <div class="tx-field">
            <span class="tx-field-label" id="tx-type-label">Type</span>
            <div class="tx-segmented" role="group" aria-labelledby="tx-type-label">
                <button type="button" class="@SegmentClass("")" aria-pressed="@(selectedType == "")" @onclick='() => SetType("")'>Tous</button>
                <button type="button" class="@SegmentClass("Dépense")" aria-pressed="@(selectedType == "Dépense")" @onclick='() => SetType("Dépense")'>Dépenses</button>
                <button type="button" class="@SegmentClass("Gain")" aria-pressed="@(selectedType == "Gain")" @onclick='() => SetType("Gain")'>Gains</button>
            </div>
        </div>

        <div class="tx-field tx-field--grow">
            <label for="transactions-recherche" class="tx-field-label">Rechercher dans le mois ouvert</label>
            <div class="tx-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="transactions-recherche" type="search" class="form-control" placeholder="Libellé, poste, voiture…"
                       @bind="searchText" @bind:event="oninput" disabled="@(!selectedMonthFilter.HasValue)" />
            </div>
        </div>
    </div>

    <!-- Mois -->
    @if (recapByMonth != null && recapByMonth.Any())
    {
        var mois = recapByMonth.OrderByDescending(r => r.Year).ThenByDescending(r => r.Month).ToList();
        var echelle = Math.Max(1m, mois.Max(r => Math.Max(r.TotalDepenses, r.TotalGains)));

        <div class="tx-months">
            @foreach (var recap in mois)
            {
                var solde = recap.TotalGains - recap.TotalDepenses;
                var ouvert = IsMonthOpen(recap);
                var panelId = $"tx-mois-{recap.Year}-{recap.Month}";
                <section class="tx-month @(ouvert ? "is-open" : "")">
                    <button type="button" class="tx-month-head" aria-expanded="@ouvert" aria-controls="@panelId"
                            @onclick="() => ToggleMonth(recap.Month, recap.Year)">
                        <i class="bi bi-chevron-right tx-chevron" aria-hidden="true"></i>
                        <span class="tx-month-name">
                            <strong>@GetMonthName(recap.Month) @recap.Year</strong>
                            <small>@recap.Count @(recap.Count > 1 ? "opérations" : "opération")</small>
                        </span>
                        <span class="tx-bars" aria-hidden="true">
                            <span class="tx-bar tx-bar--expense" style="width:@BarWidth(recap.TotalDepenses, echelle)%"></span>
                            <span class="tx-bar tx-bar--income" style="width:@BarWidth(recap.TotalGains, echelle)%"></span>
                        </span>
                        <span class="tx-amount tx-amount--expense" title="Dépenses">@SignedMontant(recap.TotalDepenses, '-')</span>
                        <span class="tx-amount tx-amount--income" title="Gains">@SignedMontant(recap.TotalGains, '+')</span>
                        <span class="tx-amount tx-amount--solde @(solde >= 0 ? "is-positive" : "is-negative")" title="Solde">@SignedMontant(Math.Abs(solde), solde >= 0 ? '+' : '-')</span>
                    </button>

                    @if (ouvert)
                    {
                        <div class="tx-month-panel" id="@panelId">
                            @if (isLoadingMonth)
                            {
                                <p class="tx-empty" role="status">Chargement…</p>
                            }
                            else if (FilteredTransactions.Any())
                            {
                                <div class="tx-table-wrap">
                                    <table class="tx-table">
                                        <caption class="visually-hidden">Transactions de @GetMonthName(recap.Month) @recap.Year</caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">Date</th>
                                                <th scope="col">Libellé</th>
                                                <th scope="col" class="tx-col-amount">Montant</th>
                                                <th scope="col" class="tx-col-actions"><span class="visually-hidden">Actions</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var transaction in FilteredTransactions)
                                            {
                                                var depense = transaction.Type == "Dépense";
                                                <tr class="@(depense ? "is-expense" : "is-income")">
                                                    <td class="tx-col-date">
                                                        <span class="tx-day">@transaction.Date.ToString("dd", Fr)</span>
                                                        <span class="tx-weekday">@transaction.Date.ToString("ddd", Fr)</span>
                                                    </td>
                                                    <td class="tx-col-label">
                                                        <span class="tx-label">@(!string.IsNullOrWhiteSpace(transaction.Libelle) ? transaction.Libelle : "Sans libellé")</span>
                                                        @if (!string.IsNullOrWhiteSpace(transaction.Description))
                                                        {
                                                            <span class="tx-desc" title="@transaction.Description">@transaction.Description</span>
                                                        }
                                                        <span class="tx-tags">
                                                            @if (transaction.Poste != null)
                                                            {
                                                                <span class="tx-tag tx-tag--poste"><i class="bi bi-folder-fill" aria-hidden="true"></i>@transaction.Poste.Nom</span>
                                                            }
                                                            @if (transaction.Voiture != null)
                                                            {
                                                                <span class="tx-tag tx-tag--voiture"><i class="bi bi-car-front-fill" aria-hidden="true"></i>@transaction.Voiture.Nom</span>
                                                            }
                                                            @if (transaction.Client != null)
                                                            {
                                                                <span class="tx-tag tx-tag--client"><i class="bi bi-person-vcard-fill" aria-hidden="true"></i>@transaction.Client.Nom @transaction.Client.Prenom</span>
                                                            }
                                                            @if (transaction.Reservation != null)
                                                            {
                                                                <span class="tx-tag tx-tag--reservation"><i class="bi bi-calendar-check" aria-hidden="true"></i>Réservation #@transaction.Reservation.Id</span>
                                                            }
                                                        </span>
                                                    </td>
                                                    <td class="tx-col-amount">
                                                        <span class="tx-amount @(depense ? "tx-amount--expense" : "tx-amount--income")">@(depense ? "-" : "+")@FormatMontant(Math.Abs(transaction.Montant))</span>
                                                    </td>
                                                    <td class="tx-col-actions">
                                                        <button type="button" class="btn btn-icon btn-outline-primary" @onclick="() => EditTransaction(transaction)" title="Modifier" aria-label="Modifier @transaction.Libelle">
                                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-icon btn-outline-danger" @onclick="() => DeleteTransaction(transaction)" title="Supprimer" aria-label="Supprimer @transaction.Libelle">
                                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="tx-empty">@(string.IsNullOrWhiteSpace(searchText) ? "Aucune transaction pour ce mois." : "Aucune transaction ne correspond à la recherche.")</p>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    }
    else
    {
        <div class="tx-empty tx-empty--page">
            <i class="bi bi-inbox" aria-hidden="true"></i>
            <p>Aucune transaction trouvée pour cette période.</p>
        </div>
    }
</div>

<!-- Modal pour ajouter/éditer une transaction -->
@if (showModal)
{
    <div class="modal show d-block modal-backdrop-custom" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-title">@(currentTransaction.Id == 0 ? "Ajouter" : "Modifier") une transaction</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert alert-danger mb-3" role="alert">
                            @statusMessage
                        </div>
                    }
                    <EditForm Model="currentTransaction" OnValidSubmit="SaveTransaction">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="transactions-champ-3" class="form-label">Date *</label>
                            <InputDate id="transactions-champ-3" class="form-control" @bind-Value="currentTransaction.Date" />
                            <ValidationMessage For="@(() => currentTransaction.Date)" />
                        </div>
                        <div class="mb-3">
                            <label for="transactions-champ-4" class="form-label">Type *</label>
                            <select id="transactions-champ-4" class="form-select" @bind="currentTransaction.Type" @bind:after="OnTypeChanged">
                                <option value="Dépense">Dépense</option>
                                <option value="Gain">Gain</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="transactions-champ-5" class="form-label">Libellé @(currentTransaction.Type == "Gain" ? "*" : "(optionnel)")</label>
                            <InputText id="transactions-champ-5" class="form-control" @bind-Value="currentTransaction.Libelle" />
                            <ValidationMessage For="@(() => currentTransaction.Libelle)" />
                        </div>
                        @if (currentTransaction.Type == "Dépense")
                        {
                            <div class="mb-3">
                                <label for="transactions-champ-6" class="form-label">Poste de dépense</label>
                                <select id="transactions-champ-6" class="form-select" @bind="selectedPosteId" @bind:after="OnPosteChanged">
                                    <option value="">Aucun poste</option>
                                    @foreach (var poste in postes)
                                    {
                                        <option value="@poste.Id">@poste.Nom</option>
                                    }
                                </select>
                            </div>
                            @if (selectedPoste != null && selectedPoste.PeutAvoirVoiture)
                            {
                                <div class="mb-3">
                                    <label for="transactions-champ-7" class="form-label">Voiture</label>
                                    <select id="transactions-champ-7" class="form-select" @bind="selectedVoitureId">
                                        <option value="">Aucune voiture</option>
                                        @foreach (var voiture in voitures)
                                        {
                                            <option value="@voiture.Id">@voiture.Nom</option>
                                        }
                                    </select>
                                </div>
                            }
                        }
                        else if (currentTransaction.Type == "Gain")
                        {
                            <div class="mb-3">
                                <label for="transactions-champ-8" class="form-label">Client *</label>
                                <select id="transactions-champ-8" class="form-select" @bind="selectedClientId" @bind:after="OnGainClientChanged">
                                    <option value="">Sélectionner un client</option>
                                    @foreach (var client in clients)
                                    {
                                        <option value="@client.Id">@client.Nom @client.Prenom</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="transactions-champ-9" class="form-label">Poste de dépense</label>
                                <select id="transactions-champ-9" class="form-select" @bind="selectedPosteId" @bind:after="OnPosteChanged">
                                    <option value="">Aucun poste</option>
                                    @foreach (var poste in postes)
                                    {
                                        <option value="@poste.Id">@poste.Nom</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="transactions-champ-10" class="form-label">Voiture</label>
                                <select id="transactions-champ-10" class="form-select" @bind="selectedVoitureId">
                                    <option value="">Aucune voiture</option>
                                    @foreach (var voiture in voitures)
                                    {
                                        <option value="@voiture.Id">@voiture.Nom</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (reservations.Any())
                        {
                            var availableReservations = GetAvailableReservations().ToList();
                            <div class="mb-3">
                                <label class="form-label" id="transactions-reservation-label">Réservation associée</label>
                                @if (!availableReservations.Any())
                                {
                                    <div class="form-text">
                                        Aucune réservation disponible pour cette sélection.
                                    </div>
                                }
                                else
                                {
                                    <InputSelect class="form-select" aria-labelledby="transactions-reservation-label" @bind-Value="currentTransaction.ReservationId" TValue="int?">
                                        <option value="">Aucune réservation</option>
                                        @foreach (var reservation in availableReservations)
                                        {
                                            <option value="@reservation.Id">@GetReservationLabel(reservation)</option>
                                        }
                                    </InputSelect>
                                }
                            </div>
                        }
                        <div class="mb-3">
                            <label for="transactions-champ-11" class="form-label">Montant *</label>
                            <InputNumber id="transactions-champ-11" class="form-control" @bind-Value="currentTransaction.Montant" />
                            <ValidationMessage For="@(() => currentTransaction.Montant)" />
                        </div>
                        <div class="mb-3">
                            <label for="transactions-champ-12" class="form-label">Description</label>
                            <InputTextArea id="transactions-champ-12" class="form-control" @bind-Value="currentTransaction.Description" rows="3" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Transaction> transactions = new();
    private List<RecapMensuel> recapByMonth = new();
    private int? selectedMonthFilter;
    private int selectedYear = DateTime.Now.Year;
    private string selectedType = "";
    private bool showModal = false;
    private Transaction currentTransaction = new();
    private List<int> availableYears = new();
    private List<Poste> postes = new();
    private List<Voiture> voitures = new();
    private List<Client> clients = new();
    private List<Reservation> reservations = new();
    private int? selectedPosteId;
    private int? selectedVoitureId;
    private int? selectedClientId;
    private Poste? selectedPoste;
    private string? statusMessage;
    private int? selectedMonthYear;
    private string searchText = string.Empty;
    private bool isLoadingMonth;
    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR");

    protected override async Task OnInitializedAsync()
    {
        await LoadPostes();
        await LoadVoitures();
        await LoadClients();
        await LoadReservations();
        await LoadTransactions();
        await LoadRecap();
        LoadAvailableYears();
    }

    private async Task LoadPostes()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            postes = new List<Poste>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        postes = await db.Postes
            .Where(p => p.UtilisateurId == userId.Value)
            .OrderBy(p => p.Nom)
            .ToListAsync();
    }

    private async Task LoadVoitures()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            voitures = new List<Voiture>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        voitures = await db.Voitures
            .Where(v => v.UtilisateurId == userId.Value)
            .OrderBy(v => v.Nom)
            .ToListAsync();
    }

    private async Task LoadClients()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            clients = new List<Client>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        clients = await db.Clients
            .Where(c => c.UtilisateurId == userId.Value)
            .OrderBy(c => c.Nom)
            .ThenBy(c => c.Prenom)
            .ToListAsync();
    }

    private async Task LoadReservations()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            reservations = new List<Reservation>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        reservations = await db.Reservations
            .Where(r => r.UtilisateurId == userId.Value)
            .Include(r => r.Client)
            .OrderByDescending(r => r.DateDebut)
            .ToListAsync();
    }

    private void OnPosteChanged()
    {
        selectedPoste = postes.FirstOrDefault(p => p.Id == selectedPosteId);
        if (selectedPoste == null || !selectedPoste.PeutAvoirVoiture)
        {
            selectedVoitureId = null;
        }
    }

    private void OnTypeChanged()
    {
        // Réinitialiser les sélections lors du changement de type
        if (currentTransaction.Type == "Dépense")
        {
            selectedClientId = null;
            currentTransaction.ReservationId = null;
        }
        else if (currentTransaction.Type == "Gain")
        {
            // On garde le poste pour les gains maintenant
            // Pas besoin de réinitialiser selectedPosteId
        }
    }

    private void OnGainClientChanged()
    {
        currentTransaction.ReservationId = null;
        StateHasChanged();
    }

    private void LoadAvailableYears()
    {
        // Générer une liste d'années de 2023 à 2027
        availableYears = Enumerable.Range(2023, Math.Max(2027, DateTime.Now.Year) - 2023 + 1).ToList();
        
        // Ajouter aussi les années qui existent dans les transactions si elles ne sont pas déjà dans la liste
        if (transactions.Any())
        {
            var transactionYears = transactions.Select(t => t.Date.Year).Distinct().ToList();
            foreach (var year in transactionYears)
            {
                if (!availableYears.Contains(year))
                {
                    availableYears.Add(year);
                }
            }
        }
        
        // Trier par ordre décroissant
        availableYears = availableYears.OrderByDescending(y => y).ToList();
    }

    private async Task LoadTransactions()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue || !selectedMonthFilter.HasValue || !selectedMonthYear.HasValue)
        {
            transactions = new List<Transaction>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        var query = db.Transactions
            .Where(t => t.UtilisateurId == userId.Value)
            .Where(t => t.Date.Month == selectedMonthFilter.Value && t.Date.Year == selectedMonthYear.Value);

        if (!string.IsNullOrEmpty(selectedType))
        {
            query = query.Where(t => t.Type == selectedType);
        }

        transactions = await query
            .Include(t => t.Poste)
            .Include(t => t.Voiture)
            .Include(t => t.Client)
            .Include(t => t.Reservation)
                .ThenInclude(r => r.Client)
            .OrderByDescending(t => t.Date)
            .ToListAsync();
    }

    private async Task LoadRecap()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            recapByMonth = new List<RecapMensuel>();
            await LoadTransactions();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        var query = db.Transactions
            .Where(t => t.UtilisateurId == userId.Value)
            .AsQueryable();

        if (selectedYear > 0)
        {
            query = query.Where(t => t.Date.Year == selectedYear);
        }

        if (!string.IsNullOrEmpty(selectedType))
        {
            query = query.Where(t => t.Type == selectedType);
        }

        var allTransactions = await query.ToListAsync();

        recapByMonth = allTransactions
            .GroupBy(t => new { t.Date.Year, t.Date.Month })
            .Select(g => new RecapMensuel
            {
                Year = g.Key.Year,
                Month = g.Key.Month,
                TotalDepenses = g.Where(t => t.Type == "Dépense").Sum(t => t.Montant),
                TotalGains = g.Where(t => t.Type == "Gain").Sum(t => t.Montant),
                Count = g.Count()
            })
            .ToList();

        await LoadTransactions();
    }

    private void ShowAddTransactionModal()
    {
        currentTransaction = new Transaction 
        { 
            Date = DateTime.Now,
            Type = "Dépense"
        };
        selectedPosteId = null;
        selectedVoitureId = null;
        selectedClientId = null;
        currentTransaction.ReservationId = null;
        selectedPoste = null;
        statusMessage = null;
        showModal = true;
    }

    private void EditTransaction(Transaction transaction)
    {
        currentTransaction = new Transaction
        {
            Id = transaction.Id,
            Date = transaction.Date,
            Montant = transaction.Montant,
            Libelle = transaction.Libelle,
            Description = transaction.Description,
            Type = transaction.Type,
            PosteId = transaction.PosteId,
            VoitureId = transaction.VoitureId,
            ClientId = transaction.ClientId,
            ReservationId = transaction.ReservationId
        };
        selectedPosteId = transaction.PosteId;
        selectedVoitureId = transaction.VoitureId;
        selectedClientId = transaction.ClientId;
        selectedPoste = transaction.Poste;
        statusMessage = null;
        showModal = true;
    }

    private async Task SaveTransaction()
    {
        // Validation : le client est obligatoire pour les gains
        if (currentTransaction.Type == "Gain" && !selectedClientId.HasValue)
        {
            statusMessage = "Le client est obligatoire pour un gain.";
            StateHasChanged();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        // Mettre à jour les IDs selon le type
        if (currentTransaction.Type == "Dépense")
        {
            currentTransaction.PosteId = selectedPosteId;
            currentTransaction.ClientId = null;
            currentTransaction.ReservationId = null;
        }
        else if (currentTransaction.Type == "Gain")
        {
            currentTransaction.ClientId = selectedClientId;
            currentTransaction.PosteId = selectedPosteId; // Permettre le poste pour les gains
        }
        
        currentTransaction.VoitureId = selectedVoitureId;

        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            statusMessage = "Vous devez être connecté pour enregistrer une transaction.";
            StateHasChanged();
            return;
        }

        if (currentTransaction.Id == 0)
        {
            // Nouvelle transaction : définir l'UtilisateurId
            currentTransaction.UtilisateurId = userId.Value;
            db.Transactions.Add(currentTransaction);
        }
        else
        {
            var existing = await db.Transactions.FindAsync(currentTransaction.Id);
            if (existing != null)
            {
                // Vérifier que la transaction appartient à l'utilisateur connecté
                if (existing.UtilisateurId != userId.Value)
                {
                    statusMessage = "Vous n'avez pas l'autorisation de modifier cette transaction.";
                    StateHasChanged();
                    return;
                }
                existing.Date = currentTransaction.Date;
                existing.Montant = currentTransaction.Montant;
                existing.Libelle = currentTransaction.Libelle;
                existing.Description = currentTransaction.Description;
                existing.Type = currentTransaction.Type;
                existing.PosteId = currentTransaction.PosteId;
                existing.VoitureId = currentTransaction.VoitureId;
                existing.ClientId = currentTransaction.ClientId;
                existing.ReservationId = currentTransaction.ReservationId;
                db.Transactions.Update(existing);
            }
        }

        await db.SaveChangesAsync();
        statusMessage = null;
        CloseModal();
        await LoadRecap();
    }

    private async Task DeleteTransaction(Transaction transaction)
    {
        if (!await ConfirmDelete())
            return;

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        db.Transactions.Remove(transaction);
        await db.SaveChangesAsync();
        await LoadRecap();
    }

    private void CloseModal()
    {
        showModal = false;
        currentTransaction = new();
        selectedPosteId = null;
        selectedVoitureId = null;
        selectedClientId = null;
        currentTransaction.ReservationId = null;
        selectedPoste = null;
        statusMessage = null;
    }

    private string GetMonthName(int month)
    {
        return new DateTime(2000, month, 1).ToString("MMMM", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));
    }

    private IEnumerable<Reservation> GetAvailableReservations()
    {
        if (!reservations.Any())
        {
            return Enumerable.Empty<Reservation>();
        }

        if (currentTransaction.Type == "Gain" && selectedClientId.HasValue)
        {
            return reservations.Where(r => r.ClientId == selectedClientId.Value);
        }

        return reservations;
    }

    private string GetReservationLabel(Reservation reservation)
    {
        var clientName = reservation.Client != null
            ? $"{reservation.Client.Nom} {reservation.Client.Prenom}".Trim()
            : $"Client #{reservation.ClientId}";

        var culture = CultureInfo.GetCultureInfo("fr-FR");
        var start = reservation.DateDebut.ToString("dd MMM yy", culture);
        var end = reservation.DateFin.ToString("dd MMM yy", culture);

        return $"{clientName} • {start} → {end}";
    }

    private async Task<bool> ConfirmDelete()
    {
        return await JSRuntime.InvokeAsync<bool>("confirm", "Êtes-vous sûr de vouloir supprimer cette transaction ?");
    }

    private bool IsMonthOpen(RecapMensuel recap)
        => selectedMonthFilter == recap.Month && selectedMonthYear == recap.Year;

    private async Task ToggleMonth(int month, int year)
    {
        if (selectedMonthFilter == month && selectedMonthYear == year)
        {
            selectedMonthFilter = null;
            selectedMonthYear = null;
        }
        else
        {
            selectedMonthFilter = month;
            selectedMonthYear = year;
        }

        searchText = string.Empty;

        if (selectedMonthFilter.HasValue)
        {
            isLoadingMonth = true;
            transactions = new List<Transaction>();
            StateHasChanged();
        }

        try
        {
            await LoadTransactions();
        }
        finally
        {
            isLoadingMonth = false;
        }
    }

    private async Task OnFilterChanged()
    {
        selectedMonthFilter = null;
        selectedMonthYear = null;
        searchText = string.Empty;
        await LoadRecap();
    }

    private async Task SetType(string type)
    {
        if (selectedType == type)
        {
            return;
        }

        selectedType = type;
        await OnFilterChanged();
    }

    private string SegmentClass(string type) => selectedType == type ? "tx-segment is-active" : "tx-segment";

    private static string FormatMontant(decimal montant) => $"{montant.ToString("N2", Fr)} €";

    private static string SignedMontant(decimal montant, char signe) => montant == 0 ? FormatMontant(0) : signe + FormatMontant(montant);

    private static string BarWidth(decimal montant, decimal echelle)
        => Math.Round(Math.Min(100m, montant / echelle * 100m), 1).ToString(CultureInfo.InvariantCulture);

    private decimal TotalDepensesPeriode => recapByMonth.Sum(r => r.TotalDepenses);

    private decimal TotalGainsPeriode => recapByMonth.Sum(r => r.TotalGains);

    private decimal SoldePeriode => TotalGainsPeriode - TotalDepensesPeriode;

    private string PeriodLabel => selectedYear > 0 ? $"Année {selectedYear}" : "Toutes les années";

    private IEnumerable<Transaction> FilteredTransactions
    {
        get
        {
            var texte = searchText?.Trim();
            var resultat = transactions.AsEnumerable();

            if (!string.IsNullOrEmpty(texte))
            {
                resultat = resultat.Where(t =>
                    Contient(t.Libelle, texte) || Contient(t.Description, texte) ||
                    Contient(t.Poste?.Nom, texte) || Contient(t.Voiture?.Nom, texte) ||
                    Contient(t.Client?.Nom, texte) || Contient(t.Client?.Prenom, texte));
            }

            return resultat.OrderByDescending(t => t.Date).ThenByDescending(t => t.Id);
        }
    }

    private static bool Contient(string? valeur, string texte)
        => valeur != null && Fr.CompareInfo.IndexOf(valeur, texte, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0;

    private class RecapMensuel
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public decimal TotalDepenses { get; set; }
        public decimal TotalGains { get; set; }
        public int Count { get; set; }
    }
}

