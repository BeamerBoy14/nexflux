@page "/voitures"
@using comptabilité.Models
@using comptabilité.Data
@using comptabilité.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject IServiceScopeFactory ServiceScopeFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@rendermode InteractiveServer

<PageTitle>Voitures</PageTitle>

<div class="container mt-4 vt-page">
    <div class="vt-header">
        <div>
            <h2 class="vt-title">Voitures</h2>
            <p class="vt-subtitle">@(isLoading ? "Chargement…" : $"{voitures.Count} véhicule{(voitures.Count > 1 ? "s" : "")} · {FormatMontant(TotalDepenses)} dépensés")</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> Ajouter une voiture
        </button>
    </div>

    @if (isLoading)
    {
        <div class="vt-list vt-list--loading" aria-hidden="true">
            @for (var i = 0; i < 3; i++)
            {
                <div class="vt-skeleton-row">
                    <div class="skeleton-chip vt-skeleton-logo"></div>
                    <div class="vt-skeleton-lines">
                        <div class="skeleton-line w-40"></div>
                        <div class="skeleton-line w-60"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!voitures.Any())
    {
        <div class="vt-empty">
            <i class="bi bi-car-front-fill" aria-hidden="true"></i>
            <p class="vt-empty-title">Aucune voiture enregistrée</p>
            <p>Ajoutez votre premier véhicule pour commencer.</p>
        </div>
    }
    else
    {
        var principale = VoiturePrincipale;
        <div class="vt-kpis">
            <div class="vt-kpi">
                <span class="vt-kpi-label">Véhicules</span>
                <span class="vt-kpi-value">@voitures.Count</span>
                <span class="vt-kpi-sub">@(TotalKilometrage > 0 ? $"{TotalKilometrage.ToString("N0", Fr)} km cumulés" : "Kilométrage non renseigné")</span>
            </div>
            <div class="vt-kpi vt-kpi--expense">
                <span class="vt-kpi-label">Total dépensé</span>
                <span class="vt-kpi-value">@FormatMontant(TotalDepenses)</span>
                <span class="vt-kpi-sub">@TotalOperations opération@(TotalOperations > 1 ? "s" : "") liée@(TotalOperations > 1 ? "s" : "") à une voiture</span>
            </div>
            <div class="vt-kpi">
                <span class="vt-kpi-label">Véhicule le plus coûteux</span>
                <span class="vt-kpi-value vt-kpi-value--text">@(principale?.Nom ?? "-")</span>
                <span class="vt-kpi-sub">@(principale != null ? $"{FormatMontant(StatsDe(principale).Depenses)} · {Part(principale):0} % des dépenses" : "Aucune dépense liée")</span>
            </div>
        </div>

        <div class="vt-toolbar">
            <div class="vt-field vt-field--grow">
                <label for="voitures-recherche" class="vt-field-label">Rechercher</label>
                <div class="vt-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="voitures-recherche" type="search" class="form-control" placeholder="Nom, immatriculation, description…"
                           value="@searchText" @oninput="OnSearchInput" />
                </div>
            </div>
            <div class="vt-field">
                <label for="voitures-tri" class="vt-field-label">Trier par</label>
                <select id="voitures-tri" class="form-select" value="@sortMode" @onchange="OnSortChanged">
                    <option value="nom">Nom (A → Z)</option>
                    <option value="depense">Dépenses (plus élevées d'abord)</option>
                    <option value="annee">Année (plus récentes d'abord)</option>
                    <option value="km">Kilométrage (plus élevé d'abord)</option>
                </select>
            </div>
        </div>

        @if (!FilteredVoitures.Any())
        {
            <div class="vt-empty">
                <i class="bi bi-search" aria-hidden="true"></i>
                <p class="vt-empty-title">Aucun résultat</p>
                <p>Aucune voiture ne correspond à « @searchText ».</p>
            </div>
        }
        else
        {
            <div class="vt-list">
                <div class="vt-table-wrap">
                    <table class="vt-table">
                        <caption class="visually-hidden">Liste des voitures</caption>
                        <thead>
                            <tr>
                                <th scope="col">Voiture</th>
                                <th scope="col" class="vt-col-wide">Véhicule</th>
                                <th scope="col" class="vt-col-amount">Dépensé</th>
                                <th scope="col" class="vt-col-actions"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var voiture in FilteredVoitures)
                            {
                                var stats = StatsDe(voiture);
                                <tr @onclick="() => ViewDetails(voiture.Id)">
                                    <td class="vt-col-voiture">
                                        <div class="vt-voiture-cell">
                                            <VoitureLogoBadge VoitureId="voiture.Id" Nom="@voiture.Nom" Version="voiture.LogoUpdatedAt" Size="sm" />
                                            <span class="vt-identity">
                                                <a class="vt-name" href="/voitures/@voiture.Id" @onclick:stopPropagation="true">@voiture.Nom</a>
                                                @if (!string.IsNullOrWhiteSpace(voiture.Description))
                                                {
                                                    <span class="vt-desc" title="@voiture.Description">@voiture.Description</span>
                                                }
                                                <span class="vt-inline-meta">@InlineInfo(voiture)</span>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="vt-col-wide">
                                        <span class="vt-line"><span class="vt-key">Immat.</span>@FormatValue(voiture.Immatriculation)</span>
                                        <span class="vt-line"><span class="vt-key">Année</span>@(voiture.Annee?.ToString() ?? "-")</span>
                                        <span class="vt-line"><span class="vt-key">Km</span>@FormatKilometrage(voiture.Kilometrage)</span>
                                    </td>
                                    <td class="vt-col-amount">
                                        <span class="vt-amount">@FormatMontant(stats.Depenses)</span>
                                        <span class="vt-share" role="img" aria-label="@Part(voiture).ToString("0") % des dépenses">
                                            <span class="vt-share-bar" style="width:@PartBarre(voiture)%"></span>
                                        </span>
                                        <small class="vt-last">@stats.Count opération@(stats.Count > 1 ? "s" : "")@(stats.Gains > 0 ? $" · +{FormatMontant(stats.Gains)} de gains" : "")</small>
                                    </td>
                                    <td class="vt-col-actions">
                                        <button type="button" class="btn btn-icon btn-outline-primary" @onclick="() => EditVoiture(voiture)" @onclick:stopPropagation="true" title="Modifier" aria-label="Modifier @voiture.Nom">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="btn btn-icon btn-outline-danger" @onclick="() => DeleteVoiture(voiture)" @onclick:stopPropagation="true" title="Supprimer" aria-label="Supprimer @voiture.Nom">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<!-- Modal -->
@if (showModal)
{
    <div class="modal show d-block modal-backdrop-custom" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-title">@(currentVoiture.Id == 0 ? "Ajouter" : "Modifier") une voiture</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentVoiture" OnValidSubmit="SaveVoiture">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="voitures-champ-1" class="form-label">Nom *</label>
                            <InputText id="voitures-champ-1" class="form-control" @bind-Value="currentVoiture.Nom" placeholder="Ex: Mustang, Corvette..." />
                            <ValidationMessage For="@(() => currentVoiture.Nom)" />
                        </div>
                        <div class="mb-3">
                            <label for="voitures-champ-2" class="form-label">Immatriculation</label>
                            <InputText id="voitures-champ-2" class="form-control" @bind-Value="currentVoiture.Immatriculation" />
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label for="voitures-annee" class="form-label">Année</label>
                                <InputNumber id="voitures-annee" class="form-control" @bind-Value="currentVoiture.Annee" placeholder="Ex: 1969" />
                                <ValidationMessage For="@(() => currentVoiture.Annee)" />
                            </div>
                            <div class="col-6 mb-3">
                                <label for="voitures-kilometrage" class="form-label">Kilométrage (km)</label>
                                <InputNumber id="voitures-kilometrage" class="form-control" @bind-Value="currentVoiture.Kilometrage" placeholder="Ex: 85000" />
                                <ValidationMessage For="@(() => currentVoiture.Kilometrage)" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="voitures-logo" class="form-label">Logo</label>
                            <div class="voiture-logo-field">
                                @if (!string.IsNullOrEmpty(pendingLogoPreview))
                                {
                                    <img class="voiture-logo voiture-logo--md" src="@pendingLogoPreview" alt="Aperçu du logo" />
                                }
                                else if (currentVoiture.Id != 0 && currentVoiture.LogoUpdatedAt.HasValue && !removeLogo)
                                {
                                    <VoitureLogoBadge VoitureId="currentVoiture.Id" Nom="@currentVoiture.Nom" Version="currentVoiture.LogoUpdatedAt" Size="md" />
                                }
                                else
                                {
                                    <VoitureLogoBadge VoitureId="currentVoiture.Id" Nom="@currentVoiture.Nom" Version="null" Size="md" />
                                }
                                <div class="voiture-logo-actions">
                                    <InputFile id="voitures-logo" class="form-control" accept=".png,.jpg,.jpeg,.webp,.gif" OnChange="OnLogoSelected" />
                                    <div class="form-text">PNG, JPG, WEBP ou GIF · 2 Mo maximum</div>
                                    @if (!string.IsNullOrEmpty(logoError))
                                    {
                                        <div class="text-danger small" role="alert">@logoError</div>
                                    }
                                    @if (HasLogoToRemove)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="RemoveLogo">Retirer le logo</button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="voitures-champ-3" class="form-label">Description</label>
                            <InputTextArea id="voitures-champ-3" class="form-control" @bind-Value="currentVoiture.Description" rows="3" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Voiture> voitures = new();
    private bool showModal = false;
    private Voiture currentVoiture = new();
    private bool isLoading = true;

    private sealed record VoitureStats(int Count, decimal Depenses, decimal Gains);

    private static readonly VoitureStats AucuneStat = new(0, 0m, 0m);
    private static readonly System.Globalization.CultureInfo Fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");

    private Dictionary<int, VoitureStats> stats = new();
    private string searchText = string.Empty;
    private string sortMode = "nom";

    private VoitureStats StatsDe(Voiture voiture) => stats.TryGetValue(voiture.Id, out var s) ? s : AucuneStat;

    private decimal TotalDepenses => stats.Values.Sum(s => s.Depenses);

    private int TotalOperations => stats.Values.Sum(s => s.Count);

    private long TotalKilometrage => voitures.Sum(v => (long)(v.Kilometrage ?? 0));

    private Voiture? VoiturePrincipale => voitures
        .Where(v => StatsDe(v).Depenses > 0)
        .OrderByDescending(v => StatsDe(v).Depenses)
        .FirstOrDefault();

    private decimal Part(Voiture voiture) => TotalDepenses > 0 ? StatsDe(voiture).Depenses / TotalDepenses * 100m : 0m;

    private string PartBarre(Voiture voiture)
        => Math.Round(Math.Min(100m, Part(voiture)), 1).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatMontant(decimal montant) => $"{montant.ToString("N2", Fr)} €";

    private string InlineInfo(Voiture voiture)
    {
        var infos = new List<string>();
        if (!string.IsNullOrWhiteSpace(voiture.Immatriculation)) infos.Add(voiture.Immatriculation!);
        if (voiture.Annee.HasValue) infos.Add(voiture.Annee.Value.ToString());
        if (voiture.Kilometrage.HasValue) infos.Add(FormatKilometrage(voiture.Kilometrage));
        return string.Join(" · ", infos);
    }

    private IEnumerable<Voiture> FilteredVoitures
    {
        get
        {
            var texte = searchText.Trim();
            var resultat = voitures.AsEnumerable();

            if (texte.Length > 0)
            {
                resultat = resultat.Where(v => Contient(v.Nom, texte) || Contient(v.Immatriculation, texte) || Contient(v.Description, texte));
            }

            return sortMode switch
            {
                "depense" => resultat.OrderByDescending(v => StatsDe(v).Depenses).ThenBy(v => v.Nom),
                "annee" => resultat.OrderByDescending(v => v.Annee ?? 0).ThenBy(v => v.Nom),
                "km" => resultat.OrderByDescending(v => v.Kilometrage ?? 0).ThenBy(v => v.Nom),
                _ => resultat.OrderBy(v => v.Nom, StringComparer.CurrentCultureIgnoreCase)
            };
        }
    }

    private static bool Contient(string? valeur, string texte)
        => valeur != null && Fr.CompareInfo.IndexOf(valeur, texte, System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private void OnSearchInput(ChangeEventArgs e) => searchText = e.Value?.ToString() ?? string.Empty;

    private void OnSortChanged(ChangeEventArgs e) => sortMode = e.Value?.ToString() ?? "nom";

    private void ViewDetails(int voitureId) => NavigationManager.NavigateTo($"/voitures/{voitureId}");

    private byte[]? pendingLogo;
    private string? pendingLogoType;
    private string? pendingLogoPreview;
    private bool removeLogo;
    private string? logoError;

    private bool HasLogoToRemove =>
        pendingLogo is not null || (currentVoiture.LogoUpdatedAt.HasValue && !removeLogo);

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadVoitures();
        isLoading = false;
    }

    private async Task LoadVoitures()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            voitures = new List<Voiture>();
            stats = new Dictionary<int, VoitureStats>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        voitures = await db.Voitures
            .Where(v => v.UtilisateurId == userId.Value)
            .OrderBy(v => v.Nom)
            .ToListAsync();

        stats = (await db.Transactions
                .Where(t => t.UtilisateurId == userId.Value && t.VoitureId != null)
                .GroupBy(t => t.VoitureId!.Value)
                .Select(g => new
                {
                    VoitureId = g.Key,
                    Count = g.Count(),
                    Depenses = g.Sum(t => t.Type == "Dépense" ? t.Montant : 0m),
                    Gains = g.Sum(t => t.Type == "Gain" ? t.Montant : 0m)
                })
                .ToListAsync())
            .ToDictionary(x => x.VoitureId, x => new VoitureStats(x.Count, x.Depenses, x.Gains));
    }

    private void ShowAddModal()
    {
        ResetLogoState();
        currentVoiture = new Voiture();
        showModal = true;
    }

    private void EditVoiture(Voiture voiture)
    {
        ResetLogoState();
        currentVoiture = new Voiture
        {
            LogoUpdatedAt = voiture.LogoUpdatedAt,
            Id = voiture.Id,
            Nom = voiture.Nom,
            Immatriculation = voiture.Immatriculation,
            Annee = voiture.Annee,
            Kilometrage = voiture.Kilometrage,
            Description = voiture.Description
        };
        showModal = true;
    }

    private async Task SaveVoiture()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        Voiture target;

        if (currentVoiture.Id == 0)
        {
            // Nouvelle voiture : définir l'UtilisateurId
            currentVoiture.UtilisateurId = userId.Value;
            db.Voitures.Add(currentVoiture);
            target = currentVoiture;
        }
        else
        {
            var existing = await db.Voitures.FindAsync(currentVoiture.Id);
            if (existing != null)
            {
                // Vérifier que la voiture appartient à l'utilisateur connecté
                if (existing.UtilisateurId != userId.Value)
                {
                    return; // Ne pas modifier si ce n'est pas la voiture de l'utilisateur
                }
                existing.Nom = currentVoiture.Nom;
                existing.Immatriculation = currentVoiture.Immatriculation;
                existing.Annee = currentVoiture.Annee;
                existing.Kilometrage = currentVoiture.Kilometrage;
                existing.Description = currentVoiture.Description;
                db.Voitures.Update(existing);
                target = existing;
            }
            else
            {
                return;
            }
        }

        await db.SaveChangesAsync();
        await ApplyLogoChangesAsync(db, target);
        CloseModal();
        await LoadVoitures();
    }

    private async Task DeleteVoiture(Voiture voiture)
    {
        var operations = StatsDe(voiture).Count;
        var message = operations > 0
            ? $"Êtes-vous sûr de vouloir supprimer la voiture '{voiture.Nom}' ?\n\nLes {operations} opération(s) associée(s) seront conservées mais ne seront plus rattachées à aucune voiture."
            : $"Êtes-vous sûr de vouloir supprimer la voiture '{voiture.Nom}' ?";

        if (!await JSRuntime.InvokeAsync<bool>("confirm", message))
            return;

        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        // Vérifier que la voiture appartient à l'utilisateur connecté
        var existing = await db.Voitures.FindAsync(voiture.Id);
        if (existing != null && existing.UtilisateurId != userId.Value)
        {
            return; // Ne pas supprimer si ce n'est pas la voiture de l'utilisateur
        }

        db.Voitures.Remove(voiture);
        await db.SaveChangesAsync();
        await LoadVoitures();
    }

    private async Task ApplyLogoChangesAsync(ComptabiliteDbContext db, Voiture target)
    {
        if (pendingLogo is not null && pendingLogoType is not null)
        {
            var logo = await db.VoitureLogos.FindAsync(target.Id);
            if (logo is null)
            {
                db.VoitureLogos.Add(new VoitureLogo { VoitureId = target.Id, Data = pendingLogo, ContentType = pendingLogoType });
            }
            else
            {
                logo.Data = pendingLogo;
                logo.ContentType = pendingLogoType;
            }

            target.LogoUpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
        }
        else if (removeLogo)
        {
            var logo = await db.VoitureLogos.FindAsync(target.Id);
            if (logo is not null)
            {
                db.VoitureLogos.Remove(logo);
            }

            target.LogoUpdatedAt = null;
            await db.SaveChangesAsync();
        }
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        logoError = null;
        var file = e.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > LogoImage.MaxBytes)
        {
            logoError = "Le fichier dépasse 2 Mo.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(LogoImage.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var data = buffer.ToArray();

            if (!LogoImage.TryGetContentType(data, out var contentType))
            {
                logoError = "Format non reconnu. Utilisez PNG, JPG, WEBP ou GIF.";
                return;
            }

            pendingLogo = data;
            pendingLogoType = contentType;
            pendingLogoPreview = $"data:{contentType};base64,{Convert.ToBase64String(data)}";
            removeLogo = false;
        }
        catch (IOException)
        {
            logoError = "Impossible de lire ce fichier.";
        }
    }

    private void RemoveLogo()
    {
        pendingLogo = null;
        pendingLogoType = null;
        pendingLogoPreview = null;
        removeLogo = true;
        logoError = null;
    }

    private void ResetLogoState()
    {
        pendingLogo = null;
        pendingLogoType = null;
        pendingLogoPreview = null;
        removeLogo = false;
        logoError = null;
    }

    private void CloseModal()
    {
        showModal = false;
        currentVoiture = new();
        ResetLogoState();
    }

    private string FormatValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string FormatKilometrage(int? km) =>
        km.HasValue ? string.Format(System.Globalization.CultureInfo.GetCultureInfo("fr-FR"), "{0:N0} km", km.Value) : "-";
}

