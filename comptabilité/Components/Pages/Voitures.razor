@page "/voitures"
@using comptabilité.Models
@using comptabilité.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject IServiceScopeFactory ServiceScopeFactory
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Voitures</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestion des Voitures</h2>
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle"></i> Ajouter une voiture
        </button>
    </div>

    <div class="card">
        <div class="card-body">
            @if (isLoading)
            {
                <div class="skeleton-list">
                    @for (var i = 0; i < 2; i++)
                    {
                        <div class="skeleton-card">
                            <div class="skeleton-line w-45"></div>
                            <div class="skeleton-line w-60"></div>
                            <div class="skeleton-line w-35"></div>
                        </div>
                    }
                </div>
            }
            else if (voitures.Any())
            {
                <div class="inline-card-list">
                    @foreach (var voiture in voitures)
                    {
                        <div class="inline-card inline-card--voiture">
                            <div class="inline-card-overview">
                                <h5 class="inline-card-title">@voiture.Nom</h5>
                                <span class="inline-card-date">Véhicule enregistré</span>
                                @if (!string.IsNullOrWhiteSpace(voiture.Description))
                                {
                                    <p class="inline-card-description">@voiture.Description</p>
                                }
                            </div>
                            <div class="inline-card-details">
                                <div class="inline-card-detail">
                                    <span class="inline-card-detail-label">Immatriculation</span>
                                    <span class="inline-card-detail-value">@FormatValue(voiture.Immatriculation)</span>
                                </div>
                            </div>
                            <div class="inline-card-actions">
                                <button class="btn btn-icon btn-outline-primary" @onclick="() => EditVoiture(voiture)" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-icon btn-outline-danger" @onclick="() => DeleteVoiture(voiture)" title="Supprimer">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="inline-card-empty text-center text-muted">
                    <i class="bi bi-car-front-fill display-6 mb-3"></i>
                    <p class="fw-semibold mb-1">Aucune voiture enregistrée</p>
                    <p class="mb-0">Ajoutez votre premier véhicule pour commencer.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal -->
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(currentVoiture.Id == 0 ? "Ajouter" : "Modifier") une voiture</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentVoiture" OnValidSubmit="SaveVoiture">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nom *</label>
                            <InputText class="form-control" @bind-Value="currentVoiture.Nom" placeholder="Ex: Mustang, Corvette..." />
                            <ValidationMessage For="@(() => currentVoiture.Nom)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Immatriculation</label>
                            <InputText class="form-control" @bind-Value="currentVoiture.Immatriculation" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="currentVoiture.Description" rows="3" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Voiture> voitures = new();
    private bool showModal = false;
    private Voiture currentVoiture = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadVoitures();
        isLoading = false;
    }

    private async Task LoadVoitures()
    {
        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        voitures = await db.Voitures.OrderBy(v => v.Nom).ToListAsync();
    }

    private void ShowAddModal()
    {
        currentVoiture = new Voiture();
        showModal = true;
    }

    private void EditVoiture(Voiture voiture)
    {
        currentVoiture = new Voiture
        {
            Id = voiture.Id,
            Nom = voiture.Nom,
            Immatriculation = voiture.Immatriculation,
            Description = voiture.Description
        };
        showModal = true;
    }

    private async Task SaveVoiture()
    {
        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        if (currentVoiture.Id == 0)
        {
            db.Voitures.Add(currentVoiture);
        }
        else
        {
            var existing = await db.Voitures.FindAsync(currentVoiture.Id);
            if (existing != null)
            {
                existing.Nom = currentVoiture.Nom;
                existing.Immatriculation = currentVoiture.Immatriculation;
                existing.Description = currentVoiture.Description;
                db.Voitures.Update(existing);
            }
        }

        await db.SaveChangesAsync();
        CloseModal();
        await LoadVoitures();
    }

    private async Task DeleteVoiture(Voiture voiture)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer la voiture '{voiture.Nom}' ?"))
            return;

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        db.Voitures.Remove(voiture);
        await db.SaveChangesAsync();
        await LoadVoitures();
    }

    private void CloseModal()
    {
        showModal = false;
        currentVoiture = new();
    }

    private string FormatValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}

