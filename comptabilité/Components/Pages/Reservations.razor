@page "/reservations"
@using comptabilité.Models
@using comptabilité.Data
@using comptabilité.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using System.Linq
@inject IServiceScopeFactory ServiceScopeFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthService AuthService
@rendermode InteractiveServer

<PageTitle>Réservations</PageTitle>

<div class="container mt-4 rs-page">
    <div class="rs-header">
        <div>
            <h2 class="rs-title">Réservations</h2>
            <p class="rs-subtitle">@(isLoading ? "Chargement…" : $"{reservations.Count} réservation{(reservations.Count > 1 ? "s" : "")} · {upcomingReservations.Count} à venir")</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="ShowAddReservationModal" disabled="@(!clients.Any())">
            <i class="bi bi-calendar-plus" aria-hidden="true"></i> Nouvelle réservation
        </button>
    </div>

    @if (isLoading)
    {
        <div class="rs-list rs-list--loading" aria-hidden="true">
            @for (var i = 0; i < 6; i++)
            {
                <div class="rs-skeleton-row">
                    <div class="skeleton-line w-40"></div>
                    <div class="skeleton-line w-60"></div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rs-kpis">
            <div class="rs-kpi">
                <span class="rs-kpi-label">Réservations</span>
                <span class="rs-kpi-value">@reservations.Count</span>
                <span class="rs-kpi-sub">dont @upcomingReservations.Count à venir</span>
            </div>
            <div class="rs-kpi rs-kpi--income">
                <span class="rs-kpi-label">Revenus estimés</span>
                <span class="rs-kpi-value">@FormatCurrency(totalRevenue)</span>
                <span class="rs-kpi-sub">@totalTransactions transaction@(totalTransactions > 1 ? "s" : "") associée@(totalTransactions > 1 ? "s" : "")</span>
            </div>
            <div class="rs-kpi">
                <span class="rs-kpi-label">Durée cumulée</span>
                <span class="rs-kpi-value">@FormatDays(totalDays)</span>
                <span class="rs-kpi-sub">sur l'ensemble des réservations</span>
            </div>
        </div>

        <div class="rs-toolbar">
            <div class="rs-field">
                <span class="rs-field-label" id="rs-view-label">Afficher</span>
                <div class="rs-segmented" role="group" aria-labelledby="rs-view-label">
                    <button type="button" class="@SegmentClass("avenir")" aria-pressed="@(view == "avenir")" @onclick='() => SetView("avenir")'>À venir <span class="rs-count">@upcomingReservations.Count</span></button>
                    <button type="button" class="@SegmentClass("passees")" aria-pressed="@(view == "passees")" @onclick='() => SetView("passees")'>Passées <span class="rs-count">@pastReservations.Count</span></button>
                    <button type="button" class="@SegmentClass("toutes")" aria-pressed="@(view == "toutes")" @onclick='() => SetView("toutes")'>Toutes <span class="rs-count">@reservations.Count</span></button>
                </div>
            </div>
            <div class="rs-field">
                <label for="reservations-statut" class="rs-field-label">Statut</label>
                <select id="reservations-statut" class="form-select" value="@statusFilter" @onchange="OnStatusFilterChanged">
                    <option value="">Tous les statuts</option>
                    @foreach (var statut in reservationStatuses)
                    {
                        <option value="@statut">@statut</option>
                    }
                </select>
            </div>
            <div class="rs-field rs-field--grow">
                <label for="reservations-recherche" class="rs-field-label">Rechercher</label>
                <div class="rs-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="reservations-recherche" type="search" class="form-control" placeholder="Client, notes, voiture…"
                           value="@searchText" @oninput="OnSearchInput" />
                </div>
            </div>
        </div>

        @if (!reservations.Any())
        {
            <div class="rs-empty">
                <i class="bi bi-calendar-event" aria-hidden="true"></i>
                <p class="rs-empty-title">Aucune réservation</p>
                <p>Créez une nouvelle réservation pour la voir ici.</p>
            </div>
        }
        else if (!filteredReservations.Any())
        {
            <div class="rs-empty">
                <i class="bi bi-search" aria-hidden="true"></i>
                <p class="rs-empty-title">Aucun résultat</p>
                <p>Aucune réservation ne correspond à ces filtres.</p>
            </div>
        }
        else
        {
            <div class="rs-list">
                <div class="rs-table-wrap">
                    <table class="rs-table">
                        <caption class="visually-hidden">Liste des réservations</caption>
                        <thead>
                            <tr>
                                <th scope="col">Période</th>
                                <th scope="col">Client</th>
                                <th scope="col" class="rs-col-wide">Statut</th>
                                <th scope="col" class="rs-col-wide rs-col-amount">Montant</th>
                                <th scope="col" class="rs-col-actions"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reservation in displayedReservations)
                            {
                                var voituresResa = ReservationCars(reservation);
                                <tr class="@RowClass(reservation)" @onclick="() => ViewReservationClient(reservation.ClientId)">
                                    <td class="rs-col-period">
                                        <span class="rs-dates">@FormatPeriod(reservation)</span>
                                        <span class="rs-when">@RelativeLabel(reservation)<span class="rs-sep" aria-hidden="true">·</span>@FormatDays(CalculateDuration(reservation))</span>
                                    </td>
                                    <td class="rs-col-client">
                                        <a class="rs-name" href="/clients/@reservation.ClientId" @onclick:stopPropagation="true">@reservation.Client.Nom @reservation.Client.Prenom</a>
                                        @if (!string.IsNullOrWhiteSpace(reservation.Notes))
                                        {
                                            <span class="rs-notes" title="@reservation.Notes">@reservation.Notes</span>
                                        }
                                        @if (voituresResa.Any())
                                        {
                                            <span class="rs-tags">
                                                @foreach (var nomVoiture in voituresResa)
                                                {
                                                    <span class="rs-tag"><i class="bi bi-car-front-fill" aria-hidden="true"></i>@nomVoiture</span>
                                                }
                                            </span>
                                        }
                                        <span class="rs-inline-meta">
                                            <span class="rs-status @StatusClass(reservation.Statut)">@reservation.Statut</span>
                                            <span class="rs-amount">@FormatCurrency(CalculateAmount(reservation))</span>
                                        </span>
                                    </td>
                                    <td class="rs-col-wide">
                                        <span class="rs-status @StatusClass(reservation.Statut)">@reservation.Statut</span>
                                    </td>
                                    <td class="rs-col-wide rs-col-amount">
                                        <span class="rs-amount">@FormatCurrency(CalculateAmount(reservation))</span>
                                        <small class="rs-count-tx" title="@TransactionsSummary(reservation)">@reservation.Transactions.Count transaction@(reservation.Transactions.Count > 1 ? "s" : "")</small>
                                    </td>
                                    <td class="rs-col-actions">
                                        <button type="button" class="btn btn-icon btn-outline-primary" @onclick="async () => await OnEditReservation(reservation)" @onclick:stopPropagation="true" title="Modifier" aria-label="Modifier la réservation de @reservation.Client.Nom">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="btn btn-icon btn-outline-danger" @onclick="async () => await OnDeleteReservation(reservation)" @onclick:stopPropagation="true" title="Supprimer" aria-label="Supprimer la réservation de @reservation.Client.Nom">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <nav class="rs-pager" aria-label="Pagination des réservations">
                        <span class="rs-pager-info">@RangeLabel</span>
                        <div class="rs-pager-buttons">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="PreviousPage" disabled="@(currentPage <= 1)" aria-label="Page précédente">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            </button>
                            <span class="rs-pager-page">Page @currentPage / @totalPages</span>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="NextPage" disabled="@(currentPage >= totalPages)" aria-label="Page suivante">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </button>
                        </div>
                    </nav>
                }
            </div>
        }
    }
</div>

<!-- Modal création / édition réservation -->
@if (showReservationModal)
{
    <div class="modal show d-block modal-backdrop-custom" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-title">@((reservationBeingEdited?.Id ?? 0) == 0 ? "Créer une réservation" : $"Modifier la réservation #{reservationBeingEdited!.Id}")</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseReservationModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(reservationError))
                    {
                        <div class="alert alert-danger mb-3">@reservationError</div>
                    }
                    <EditForm Model="newReservation" OnValidSubmit="SaveReservation">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label for="reservations-champ-2" class="form-label">Client *</label>
                                <InputSelect id="reservations-champ-2" class="form-select" @bind-Value="newReservation.ClientId" @onchange="OnClientChanged">
                                    <option value="">Sélectionner un client</option>
                                    @foreach (var client in clients)
                                    {
                                        <option value="@client.Id">@client.Nom @client.Prenom</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => newReservation.ClientId)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label for="reservations-champ-3" class="form-label">Date de début *</label>
                                <InputDate id="reservations-champ-3" class="form-control" @bind-Value="newReservation.DateDebut" />
                                <ValidationMessage For="@(() => newReservation.DateDebut)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label for="reservations-champ-4" class="form-label">Date de fin *</label>
                                <InputDate id="reservations-champ-4" class="form-control" @bind-Value="newReservation.DateFin" />
                                <ValidationMessage For="@(() => newReservation.DateFin)" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label for="reservations-champ-5" class="form-label">Statut *</label>
                                <InputSelect id="reservations-champ-5" class="form-select" @bind-Value="newReservation.Statut">
                                    @foreach (var status in reservationStatuses)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => newReservation.Statut)" />
                            </div>
                            <div class="col-12">
                                <label for="reservations-champ-6" class="form-label">Notes</label>
                                <InputTextArea id="reservations-champ-6" class="form-control" rows="3" @bind-Value="newReservation.Notes" />
                            </div>
                            <div class="col-12" role="group" aria-labelledby="reservations-transactions-label">
                                <label class="form-label" id="reservations-transactions-label">Transactions associées</label>
                                @if (transactionWarningVisible)
                                {
                                    <div class="alert alert-warning">
                                        Cette réservation possède déjà des transactions enregistrées. Vous pouvez les ajuster ci-dessous.
                                    </div>
                                }
                                @if (isLoadingTransactions)
                                {
                                    <div class="text-muted fst-italic">Chargement des transactions disponibles...</div>
                                }
                                else if (!transactionsForClient.Any())
                                {
                                    <div class="alert alert-info mb-0">
                                        Aucune transaction disponible pour ce client. Vous pourrez les associer plus tard depuis la page des transactions.
                                    </div>
                                }
                                else
                                {
                                    <div class="reservation-transaction-selector">
                                        @foreach (var transaction in transactionsForClient)
                                        {
                                            <label for="reservations-champ-7" class="reservation-transaction-item">
                                                <input id="reservations-champ-7" type="checkbox"
                                                       value="@transaction.Id"
                                                       checked="@selectedTransactionIds.Contains(transaction.Id)"
                                                       @onchange="args => ToggleTransactionSelection(transaction.Id, args)" />
                                                <div class="reservation-transaction-content">
                                                    <span class="transaction-date">@transaction.Date.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("fr-FR"))</span>
                                                    <span class="transaction-libelle">@(!string.IsNullOrWhiteSpace(transaction.Libelle) ? transaction.Libelle : "Sans libellé")</span>
                                                    <span class="transaction-amount @(transaction.Type == "Gain" ? "text-success" : "text-danger")">
                                                        @(transaction.Type == "Gain" ? "+" : "-")@transaction.Montant.ToString("N2") €
                                                    </span>
                                                </div>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary" @onclick="CloseReservationModal">Annuler</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSavingReservation">
                                @if (isSavingReservation)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                Enregistrer
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Reservation> reservations = new();
    private List<Reservation> upcomingReservations = new();
    private List<Reservation> pastReservations = new();
    private List<Reservation> filteredReservations = new();
    private List<Reservation> displayedReservations = new();
    private List<Client> clients = new();
    private bool isLoading = true;
    private decimal totalRevenue;
    private int totalTransactions;
    private decimal totalDays;
    private int currentPage = 1;
    private const int ItemsPerPage = 12;
    private string view = "avenir";
    private bool viewInitialized;
    private string statusFilter = string.Empty;
    private string searchText = string.Empty;
    private int totalPages = 1;
    private bool showReservationModal;
    private bool isSavingReservation;
    private string? reservationError;
    private ReservationInput newReservation = new();
    private Reservation? reservationBeingEdited;
    private List<Transaction> transactionsForClient = new();
    private HashSet<int> selectedTransactionIds = new();
    private bool isLoadingTransactions;
    private bool transactionWarningVisible;
    private readonly string[] reservationStatuses = new[]
    {
        "En attente",
        "Confirmée",
        "En cours",
        "Terminée",
        "Annulée"
    };

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadClients();
        await LoadReservations();
        StateHasChanged();
        isLoading = false;
    }

    private async Task LoadClients()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            clients = new List<Client>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        clients = await db.Clients
            .Where(c => c.UtilisateurId == userId.Value)
            .OrderBy(c => c.Nom)
            .ThenBy(c => c.Prenom)
            .ToListAsync();
    }

    private async Task LoadReservations()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            reservations = new List<Reservation>();
            upcomingReservations = new List<Reservation>();
            pastReservations = new List<Reservation>();
            totalRevenue = 0;
            totalTransactions = 0;
            totalDays = 0;
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        var allReservations = await db.Reservations
            .Where(r => r.UtilisateurId == userId.Value)
            .Include(r => r.Client)
            .Include(r => r.Transactions)
            .ThenInclude(t => t.Voiture)
            .OrderByDescending(r => r.DateDebut)
            .ToListAsync();

        reservations = allReservations;
        var today = DateTime.Today;

        upcomingReservations = reservations
            .Where(r => r.DateFin >= today)
            .OrderBy(r => r.DateDebut)
            .ToList();

        pastReservations = reservations
            .Where(r => r.DateFin < today)
            .OrderByDescending(r => r.DateDebut)
            .ToList();

        if (!viewInitialized)
        {
            view = upcomingReservations.Any() ? "avenir" : "toutes";
            viewInitialized = true;
        }

        UpdateDisplayed();

        totalRevenue = reservations.Sum(r => CalculateAmount(r));
        totalTransactions = reservations.Sum(r => r.Transactions.Count);
        totalDays = reservations.Sum(r => CalculateDuration(r));
    }
    
    private void UpdateDisplayed()
    {
        IEnumerable<Reservation> resultat = view switch
        {
            "avenir" => upcomingReservations,
            "passees" => pastReservations,
            _ => reservations
        };

        if (!string.IsNullOrEmpty(statusFilter))
        {
            resultat = resultat.Where(r => r.Statut == statusFilter);
        }

        var texte = searchText.Trim();
        if (texte.Length > 0)
        {
            resultat = resultat.Where(r =>
                Contient(r.Client?.Nom, texte) || Contient(r.Client?.Prenom, texte) || Contient(r.Notes, texte) ||
                Contient(r.Statut, texte) || ReservationCars(r).Any(v => Contient(v, texte)));
        }

        // À venir : la plus proche d'abord ; sinon la plus récente d'abord
        filteredReservations = (view == "avenir"
                ? resultat.OrderBy(r => r.DateDebut)
                : resultat.OrderByDescending(r => r.DateDebut))
            .ThenBy(r => r.Id)
            .ToList();

        totalPages = Math.Max(1, (int)Math.Ceiling((double)filteredReservations.Count / ItemsPerPage));
        currentPage = Math.Clamp(currentPage, 1, totalPages);
        displayedReservations = filteredReservations.Skip((currentPage - 1) * ItemsPerPage).Take(ItemsPerPage).ToList();
    }

    private void SetView(string value)
    {
        view = value;
        currentPage = 1;
        UpdateDisplayed();
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        UpdateDisplayed();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        UpdateDisplayed();
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            UpdateDisplayed();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdateDisplayed();
        }
    }

    private string SegmentClass(string value) => view == value ? "rs-segment is-active" : "rs-segment";

    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR");

    private static bool Contient(string? valeur, string texte)
        => valeur != null && Fr.CompareInfo.IndexOf(valeur, texte, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0;

    private string RangeLabel
    {
        get
        {
            var debut = (currentPage - 1) * ItemsPerPage + 1;
            var fin = Math.Min(currentPage * ItemsPerPage, filteredReservations.Count);
            return $"{debut}–{fin} sur {filteredReservations.Count} réservation{(filteredReservations.Count > 1 ? "s" : "")}";
        }
    }

    private static string FormatPeriod(Reservation reservation)
    {
        var debut = reservation.DateDebut;
        var fin = reservation.DateFin;
        if (debut.Date == fin.Date)
        {
            return debut.ToString("dd MMM yyyy", Fr);
        }

        return debut.Year == fin.Year
            ? $"{debut.ToString("dd MMM", Fr)} → {fin.ToString("dd MMM yyyy", Fr)}"
            : $"{debut.ToString("dd MMM yyyy", Fr)} → {fin.ToString("dd MMM yyyy", Fr)}";
    }

    private static string RelativeLabel(Reservation reservation)
    {
        var today = DateTime.Today;
        if (reservation.DateDebut.Date <= today && reservation.DateFin.Date >= today)
        {
            return "En ce moment";
        }

        if (reservation.DateDebut.Date > today)
        {
            var jours = (reservation.DateDebut.Date - today).Days;
            return jours == 1 ? "Demain" : jours < 60 ? $"Dans {jours} jours" : $"Dans {jours / 30} mois";
        }

        var ecoule = (today - reservation.DateFin.Date).Days;
        return ecoule == 1 ? "Hier"
            : ecoule < 60 ? $"Il y a {ecoule} jours"
            : ecoule < 730 ? $"Il y a {ecoule / 30} mois"
            : $"Il y a {ecoule / 365} ans";
    }

    private static string RowClass(Reservation reservation)
    {
        var today = DateTime.Today;
        if (reservation.DateDebut.Date <= today && reservation.DateFin.Date >= today) return "is-current";
        return reservation.DateFin.Date < today ? "is-past" : "is-upcoming";
    }

    private static IReadOnlyList<string> ReservationCars(Reservation reservation)
        => reservation.Transactions
            .Select(t => t.Voiture?.Nom)
            .Where(nom => !string.IsNullOrWhiteSpace(nom))
            .Select(nom => nom!)
            .Distinct()
            .ToList();

    private string TransactionsSummary(Reservation reservation)
        => string.Join(" | ", reservation.Transactions
            .OrderByDescending(t => t.Date)
            .Take(8)
            .Select(t => $"{t.Date:dd/MM} {FormatCurrency(t.Montant)}"));

    private decimal CalculateAmount(Reservation reservation)
        => reservation.Transactions.Sum(t => t.Montant);

    private decimal CalculateDuration(Reservation reservation)
    {
        var days = (decimal)(reservation.DateFin.Date - reservation.DateDebut.Date).TotalDays + 1;
        return days < 0 ? 0 : days;
    }

    private void ViewReservationClient(int clientId)
    {
        NavigationManager.NavigateTo($"/clients/{clientId}");
    }

    private async Task ShowAddReservationModal()
    {
        reservationError = null;
        newReservation = new ReservationInput
        {
            DateDebut = DateTime.Today,
            DateFin = DateTime.Today.AddDays(1),
            Statut = reservationStatuses.First(),
            ClientId = clients.FirstOrDefault()?.Id.ToString() ?? string.Empty
        };
        selectedTransactionIds = new HashSet<int>();
        showReservationModal = true;
        reservationBeingEdited = null;
        transactionWarningVisible = false;
        await LoadTransactionsForClient(newReservation.ClientId);
    }

    private void CloseReservationModal()
    {
        showReservationModal = false;
        reservationError = null;
        newReservation = new ReservationInput();
        transactionsForClient = new();
        selectedTransactionIds = new HashSet<int>();
        reservationBeingEdited = null;
        transactionWarningVisible = false;
    }

    private async Task SaveReservation()
    {
        reservationError = null;

        if (!int.TryParse(newReservation.ClientId, out var clientId))
        {
            reservationError = "Veuillez sélectionner un client valide.";
            return;
        }

        if (newReservation.DateFin < newReservation.DateDebut)
        {
            reservationError = "La date de fin doit être postérieure ou égale à la date de début.";
            return;
        }

        isSavingReservation = true;

        try
        {
            using var scope = ServiceScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

            var userId = AuthService.GetUtilisateurId();
            if (!userId.HasValue)
            {
                reservationError = "Vous devez être connecté pour enregistrer une réservation.";
                isSavingReservation = false;
                return;
            }

            Reservation reservation;
            if (reservationBeingEdited == null)
            {
                reservation = new Reservation
                {
                    ClientId = clientId,
                    DateDebut = newReservation.DateDebut,
                    DateFin = newReservation.DateFin,
                    Statut = newReservation.Statut,
                    Notes = string.IsNullOrWhiteSpace(newReservation.Notes) ? null : newReservation.Notes.Trim(),
                    DateCreation = DateTime.Now,
                    UtilisateurId = userId.Value
                };

                db.Reservations.Add(reservation);
                await db.SaveChangesAsync();
            }
            else
            {
                reservation = await db.Reservations
                    .Include(r => r.Transactions)
                    .FirstAsync(r => r.Id == reservationBeingEdited.Id);

                // Vérifier que la réservation appartient à l'utilisateur connecté
                if (reservation.UtilisateurId != userId.Value)
                {
                    reservationError = "Vous n'avez pas l'autorisation de modifier cette réservation.";
                    isSavingReservation = false;
                    return;
                }

                reservation.ClientId = clientId;
                reservation.DateDebut = newReservation.DateDebut;
                reservation.DateFin = newReservation.DateFin;
                reservation.Statut = newReservation.Statut;
                reservation.Notes = string.IsNullOrWhiteSpace(newReservation.Notes) ? null : newReservation.Notes.Trim();

                db.Reservations.Update(reservation);
                await db.SaveChangesAsync();

                var transactionsToUpdate = await db.Transactions
                    .Where(t => t.ReservationId == reservation.Id)
                    .ToListAsync();

                foreach (var transaction in transactionsToUpdate)
                {
                    if (!selectedTransactionIds.Contains(transaction.Id))
                    {
                        transaction.ReservationId = null;
                    }
                }
            }

            var transactionsToLink = await db.Transactions
                .Where(t => selectedTransactionIds.Contains(t.Id))
                .ToListAsync();

            foreach (var transaction in transactionsToLink)
            {
                transaction.ReservationId = reservation.Id;
            }

            await db.SaveChangesAsync();

            CloseReservationModal();
            await LoadReservations();
        StateHasChanged();
        }
        catch (Exception ex)
        {
            reservationError = $"Erreur lors de l'enregistrement : {ex.Message}";
        }
        finally
        {
            isSavingReservation = false;
        }
    }

    private async Task LoadTransactionsForClient(string? clientId, IEnumerable<int>? preselected = null)
    {
        transactionsForClient = new();
        selectedTransactionIds = preselected != null ? new HashSet<int>(preselected) : new HashSet<int>();

        if (!int.TryParse(clientId, out var parsedId))
        {
            isLoadingTransactions = false;
            return;
        }

        isLoadingTransactions = true;

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            transactionsForClient = new List<Transaction>();
            isLoadingTransactions = false;
            return;
        }

        var query = db.Transactions
            .Where(t => t.UtilisateurId == userId.Value && t.ClientId == parsedId);

        if (reservationBeingEdited?.Id != null)
        {
            query = query.Where(t => t.ReservationId == null || t.ReservationId == reservationBeingEdited.Id);
        }
        else
        {
            query = query.Where(t => t.ReservationId == null);
        }

        transactionsForClient = await query
            .OrderByDescending(t => t.Date)
            .ToListAsync();

        var availableIds = transactionsForClient.Select(t => t.Id).ToHashSet();
        selectedTransactionIds.IntersectWith(availableIds);

        isLoadingTransactions = false;
    }

    private async Task OnClientChanged(ChangeEventArgs args)
    {
        newReservation.ClientId = args?.Value?.ToString() ?? string.Empty;
        transactionWarningVisible = false;
        await LoadTransactionsForClient(newReservation.ClientId);
    }

    private void ToggleTransactionSelection(int transactionId, ChangeEventArgs args)
    {
        selectedTransactionIds ??= new HashSet<int>();

        var isChecked = args?.Value switch
        {
            bool boolean => boolean,
            string str => str.Equals("on", StringComparison.OrdinalIgnoreCase),
            _ => false
        };

        if (isChecked)
        {
            selectedTransactionIds.Add(transactionId);
        }
        else
        {
            selectedTransactionIds.Remove(transactionId);
        }
    }

    private async Task OnEditReservation(Reservation reservation)
    {
        reservationBeingEdited = reservation;
        newReservation = new ReservationInput
        {
            ClientId = reservation.ClientId.ToString(),
            DateDebut = reservation.DateDebut,
            DateFin = reservation.DateFin,
            Statut = reservation.Statut,
            Notes = reservation.Notes
        };

        var preselected = (reservation.Transactions ?? Enumerable.Empty<Transaction>()).Select(t => t.Id).ToList();
        transactionWarningVisible = preselected.Any();
        showReservationModal = true;

        await LoadTransactionsForClient(newReservation.ClientId, preselected);
    }

    private async Task OnDeleteReservation(Reservation reservation)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Supprimer la réservation #{reservation.Id} ?"))
        {
            return;
        }

        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        var entity = await db.Reservations
            .Include(r => r.Transactions)
            .FirstOrDefaultAsync(r => r.Id == reservation.Id);

        if (entity == null || entity.UtilisateurId != userId.Value)
        {
            return; // Ne pas supprimer si ce n'est pas la réservation de l'utilisateur
        }

        foreach (var transaction in entity.Transactions)
        {
            transaction.ReservationId = null;
        }

        db.Reservations.Remove(entity);
        await db.SaveChangesAsync();

        if (reservationBeingEdited?.Id == reservation.Id)
        {
            CloseReservationModal();
        }

        await LoadReservations();
        StateHasChanged();
    }

    private static string StatusClass(string statut) => statut switch
    {
        "Confirmée" or "Validée" or "Terminée" => "rs-status--ok",
        "Annulée" or "Refusée" => "rs-status--ko",
        "En cours" => "rs-status--now",
        _ => "rs-status--wait"
    };

    private string FormatCurrency(decimal value)
        => string.Format(CultureInfo.GetCultureInfo("fr-FR"), "{0:N2} €", value);

    private string FormatDays(decimal value)
    {
        if (value <= 0)
        {
            return "-";
        }

        return value % 1 == 0
            ? string.Format(CultureInfo.GetCultureInfo("fr-FR"), "{0:N0} j", value)
            : string.Format(CultureInfo.GetCultureInfo("fr-FR"), "{0:N1} j", value);
    }

    private class ReservationInput
    {
        [Required(ErrorMessage = "Le client est obligatoire")]
        public string ClientId { get; set; } = string.Empty;

        [Required(ErrorMessage = "La date de début est obligatoire")]
        public DateTime DateDebut { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "La date de fin est obligatoire")]
        public DateTime DateFin { get; set; } = DateTime.Today.AddDays(1);

        [Required(ErrorMessage = "Le statut est obligatoire")]
        public string Statut { get; set; } = "En attente";

        [StringLength(500, ErrorMessage = "Les notes ne peuvent pas dépasser 500 caractères.")]
        public string? Notes { get; set; }
    }
}


