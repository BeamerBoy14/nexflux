@page "/reservations"
@using comptabilité.Models
@using comptabilité.Data
@using comptabilité.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using System.Linq
@inject IServiceScopeFactory ServiceScopeFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AuthService AuthService
@rendermode InteractiveServer

<PageTitle>Réservations</PageTitle>

<div class="container mt-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <h2>Gestion des Réservations</h2>
        <button class="btn btn-primary align-self-start align-self-lg-auto" @onclick="ShowAddReservationModal" disabled="@(!clients.Any())">
            <i class="bi bi-calendar-plus" aria-hidden="true"></i> Nouvelle réservation
        </button>
    </div>

    @if (isLoading)
    {
        <div class="skeleton-list">
            @for (var i = 0; i < 3; i++)
            {
                <div class="skeleton-card">
                    <div class="skeleton-line w-40"></div>
                    <div class="skeleton-line w-60"></div>
                    <div class="skeleton-line w-50"></div>
                    <div class="skeleton-inline">
                        <div class="skeleton-chip"></div>
                        <div class="skeleton-chip"></div>
                        <div class="skeleton-chip"></div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-12 col-xl-4">
                <div class="card reservation-summary-card">
                    <div class="card-body">
                        <span class="reservation-summary-label">Total réservations</span>
                        <span class="reservation-summary-value">@reservations.Count</span>
                        <span class="reservation-summary-sub">dont @upcomingReservations.Count à venir</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-4">
                <div class="card reservation-summary-card">
                    <div class="card-body">
                        <span class="reservation-summary-label">Revenus estimés</span>
                        <span class="reservation-summary-value text-success">@FormatCurrency(totalRevenue)</span>
                        <span class="reservation-summary-sub">@totalTransactions transactions associées</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-4">
                <div class="card reservation-summary-card">
                    <div class="card-body">
                        <span class="reservation-summary-label">Durée cumulée</span>
                        <span class="reservation-summary-value">@FormatDays(totalDays)</span>
                        <span class="reservation-summary-sub">basé sur @reservations.Count réservation(s)</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Réservations à venir</h5>
                        <span class="badge bg-info">@upcomingReservations.Count</span>
                    </div>
                    <div class="card-body">
                        @if (upcomingReservations.Any())
                        {
                            <div class="reservation-list">
                                @foreach (var reservation in upcomingReservations)
                                {
                                    <div class="reservation-card" @onclick="() => ViewReservationClient(reservation.ClientId)">
                                        <div class="reservation-card-header">
                                            <div>
                                                <span class="reservation-dates">
                                                    @reservation.DateDebut.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("fr-FR"))
                                                    -
                                                    @reservation.DateFin.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("fr-FR"))
                                                </span>
                                                <h5 class="reservation-title">@reservation.Client.Nom @reservation.Client.Prenom</h5>
                                                <span class="badge @GetStatusBadge(reservation.Statut)">@reservation.Statut</span>
                                            </div>
                                            <div class="reservation-card-right">
                                                <div class="reservation-amount text-success">
                                                    @FormatCurrency(CalculateAmount(reservation))
                                                </div>
                                                <div class="reservation-card-actions">
                                                    <button type="button" class="btn btn-icon btn-outline-primary" @onclick="async () => await OnEditReservation(reservation)" @onclick:stopPropagation="true" title="Modifier" aria-label="Modifier @reservation.Client.Nom">
                                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-icon btn-outline-danger" @onclick="async () => await OnDeleteReservation(reservation)" @onclick:stopPropagation="true" title="Supprimer" aria-label="Supprimer @reservation.Client.Nom">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="reservation-card-body">
                                            <div class="reservation-meta">
                                                <span><i class="bi bi-clock-history me-1" aria-hidden="true"></i>@FormatDays(CalculateDuration(reservation))</span>
                                                <span><i class="bi bi-receipt me-1" aria-hidden="true"></i>@reservation.Transactions.Count transaction(s)</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(reservation.Notes))
                                            {
                                                <p class="reservation-notes">@reservation.Notes</p>
                                            }
                                            @if (reservation.Transactions.Any())
                                            {
                                                <div class="reservation-transactions">
                                                    @foreach (var transaction in reservation.Transactions.OrderByDescending(t => t.Date).Take(3))
                                                    {
                                                        <span class="badge bg-secondary">
                                                            @transaction.Date.ToString("dd/MM") - @FormatCurrency(transaction.Montant)
                                                        </span>
                                                    }
                                                    @if (reservation.Transactions.Count > 3)
                                                    {
                                                        <span class="badge bg-secondary">+@((reservation.Transactions.Count) - 3)</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-calendar-event display-6 mb-3" aria-hidden="true"></i>
                                <p class="fw-semibold mb-1">Aucune réservation planifiée</p>
                                <p class="mb-0">Créez une nouvelle réservation pour la voir ici.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Réservations passées</h5>
                        <span class="badge bg-secondary">@pastReservations.Count</span>
                    </div>
                    <div class="card-body">
                        @if (pastReservations.Any())
                        {
                            <div class="reservation-list">
                                @foreach (var reservation in displayedPastReservations)
                                {
                                    <div class="reservation-card reservation-card--past" @onclick="() => ViewReservationClient(reservation.ClientId)">
                                        <div class="reservation-card-header">
                                            <div>
                                                <span class="reservation-dates">
                                                    @reservation.DateDebut.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("fr-FR"))
                                                    -
                                                    @reservation.DateFin.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("fr-FR"))
                                                </span>
                                                <h5 class="reservation-title">@reservation.Client.Nom @reservation.Client.Prenom</h5>
                                                <span class="badge @GetStatusBadge(reservation.Statut)">@reservation.Statut</span>
                                            </div>
                                            <div class="reservation-card-right">
                                                <div class="reservation-amount text-info">
                                                    @FormatCurrency(CalculateAmount(reservation))
                                                </div>
                                                <div class="reservation-card-actions">
                                                    <button type="button" class="btn btn-icon btn-outline-primary" @onclick="async () => await OnEditReservation(reservation)" @onclick:stopPropagation="true" title="Modifier" aria-label="Modifier @reservation.Client.Nom">
                                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-icon btn-outline-danger" @onclick="async () => await OnDeleteReservation(reservation)" @onclick:stopPropagation="true" title="Supprimer" aria-label="Supprimer @reservation.Client.Nom">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="reservation-card-body">
                                            <div class="reservation-meta">
                                                <span><i class="bi bi-clock-history me-1" aria-hidden="true"></i>@FormatDays(CalculateDuration(reservation))</span>
                                                <span><i class="bi bi-receipt me-1" aria-hidden="true"></i>@reservation.Transactions.Count transaction(s)</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(reservation.Notes))
                                            {
                                                <p class="reservation-notes">@reservation.Notes</p>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            @if (totalPages > 1)
                            {
                                <div class="d-flex justify-content-between align-items-center mt-4">
                                    <div>
                                        <span class="text-muted">Page @currentPage sur @totalPages (@pastReservations.Count réservation(s) passée(s))</span>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <label for="reservations-champ-1" class="form-label mb-0">Page :</label>
                                        <select id="reservations-champ-1" class="form-select form-select-sm select-auto" aria-label="Page"
                                                @onchange="OnPageChanged"
                                                value="@currentPage">
                                            @for (int i = 1; i <= totalPages; i++)
                                            {
                                                <option value="@i">Page @i</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-archive display-6 mb-3" aria-hidden="true"></i>
                                <p class="fw-semibold mb-1">Aucune réservation passée</p>
                                <p class="mb-0">Les réservations terminées apparaîtront ici.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal création / édition réservation -->
@if (showReservationModal)
{
    <div class="modal show d-block modal-backdrop-custom" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-title">@((reservationBeingEdited?.Id ?? 0) == 0 ? "Créer une réservation" : $"Modifier la réservation #{reservationBeingEdited!.Id}")</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseReservationModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(reservationError))
                    {
                        <div class="alert alert-danger mb-3">@reservationError</div>
                    }
                    <EditForm Model="newReservation" OnValidSubmit="SaveReservation">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label for="reservations-champ-2" class="form-label">Client *</label>
                                <InputSelect id="reservations-champ-2" class="form-select" @bind-Value="newReservation.ClientId" @onchange="OnClientChanged">
                                    <option value="">Sélectionner un client</option>
                                    @foreach (var client in clients)
                                    {
                                        <option value="@client.Id">@client.Nom @client.Prenom</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => newReservation.ClientId)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label for="reservations-champ-3" class="form-label">Date de début *</label>
                                <InputDate id="reservations-champ-3" class="form-control" @bind-Value="newReservation.DateDebut" />
                                <ValidationMessage For="@(() => newReservation.DateDebut)" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label for="reservations-champ-4" class="form-label">Date de fin *</label>
                                <InputDate id="reservations-champ-4" class="form-control" @bind-Value="newReservation.DateFin" />
                                <ValidationMessage For="@(() => newReservation.DateFin)" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label for="reservations-champ-5" class="form-label">Statut *</label>
                                <InputSelect id="reservations-champ-5" class="form-select" @bind-Value="newReservation.Statut">
                                    @foreach (var status in reservationStatuses)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => newReservation.Statut)" />
                            </div>
                            <div class="col-12">
                                <label for="reservations-champ-6" class="form-label">Notes</label>
                                <InputTextArea id="reservations-champ-6" class="form-control" rows="3" @bind-Value="newReservation.Notes" />
                            </div>
                            <div class="col-12" role="group" aria-labelledby="reservations-transactions-label">
                                <label class="form-label" id="reservations-transactions-label">Transactions associées</label>
                                @if (transactionWarningVisible)
                                {
                                    <div class="alert alert-warning">
                                        Cette réservation possède déjà des transactions enregistrées. Vous pouvez les ajuster ci-dessous.
                                    </div>
                                }
                                @if (isLoadingTransactions)
                                {
                                    <div class="text-muted fst-italic">Chargement des transactions disponibles...</div>
                                }
                                else if (!transactionsForClient.Any())
                                {
                                    <div class="alert alert-info mb-0">
                                        Aucune transaction disponible pour ce client. Vous pourrez les associer plus tard depuis la page des transactions.
                                    </div>
                                }
                                else
                                {
                                    <div class="reservation-transaction-selector">
                                        @foreach (var transaction in transactionsForClient)
                                        {
                                            <label for="reservations-champ-7" class="reservation-transaction-item">
                                                <input id="reservations-champ-7" type="checkbox"
                                                       value="@transaction.Id"
                                                       checked="@selectedTransactionIds.Contains(transaction.Id)"
                                                       @onchange="args => ToggleTransactionSelection(transaction.Id, args)" />
                                                <div class="reservation-transaction-content">
                                                    <span class="transaction-date">@transaction.Date.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("fr-FR"))</span>
                                                    <span class="transaction-libelle">@(!string.IsNullOrWhiteSpace(transaction.Libelle) ? transaction.Libelle : "Sans libellé")</span>
                                                    <span class="transaction-amount @(transaction.Type == "Gain" ? "text-success" : "text-danger")">
                                                        @(transaction.Type == "Gain" ? "+" : "-")@transaction.Montant.ToString("N2") €
                                                    </span>
                                                </div>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary" @onclick="CloseReservationModal">Annuler</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSavingReservation">
                                @if (isSavingReservation)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                Enregistrer
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Reservation> reservations = new();
    private List<Reservation> upcomingReservations = new();
    private List<Reservation> pastReservations = new();
    private List<Reservation> displayedPastReservations = new();
    private List<Client> clients = new();
    private bool isLoading = true;
    private decimal totalRevenue;
    private int totalTransactions;
    private decimal totalDays;
    private int currentPage = 1;
    private int itemsPerPage = 3;
    private int totalPages = 1;
    private bool showReservationModal;
    private bool isSavingReservation;
    private string? reservationError;
    private ReservationInput newReservation = new();
    private Reservation? reservationBeingEdited;
    private List<Transaction> transactionsForClient = new();
    private HashSet<int> selectedTransactionIds = new();
    private bool isLoadingTransactions;
    private bool transactionWarningVisible;
    private readonly string[] reservationStatuses = new[]
    {
        "En attente",
        "Confirmée",
        "En cours",
        "Terminée",
        "Annulée"
    };

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadClients();
        await LoadReservations();
        StateHasChanged();
        isLoading = false;
    }

    private async Task LoadClients()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            clients = new List<Client>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        clients = await db.Clients
            .Where(c => c.UtilisateurId == userId.Value)
            .OrderBy(c => c.Nom)
            .ThenBy(c => c.Prenom)
            .ToListAsync();
    }

    private async Task LoadReservations()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            reservations = new List<Reservation>();
            upcomingReservations = new List<Reservation>();
            pastReservations = new List<Reservation>();
            totalRevenue = 0;
            totalTransactions = 0;
            totalDays = 0;
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        var allReservations = await db.Reservations
            .Where(r => r.UtilisateurId == userId.Value)
            .Include(r => r.Client)
            .Include(r => r.Transactions)
            .ThenInclude(t => t.Voiture)
            .OrderByDescending(r => r.DateDebut)
            .ToListAsync();

        reservations = allReservations;
        var today = DateTime.Today;

        upcomingReservations = reservations
            .Where(r => r.DateFin >= today)
            .OrderBy(r => r.DateDebut)
            .ToList();

        pastReservations = reservations
            .Where(r => r.DateFin < today)
            .OrderByDescending(r => r.DateDebut)
            .ToList();

        UpdateDisplayedPastReservations();

        totalRevenue = reservations.Sum(r => CalculateAmount(r));
        totalTransactions = reservations.Sum(r => r.Transactions.Count);
        totalDays = reservations.Sum(r => CalculateDuration(r));
    }
    
    private void UpdateDisplayedPastReservations()
    {
        totalPages = (int)Math.Ceiling((double)pastReservations.Count / itemsPerPage);
        if (currentPage > totalPages && totalPages > 0)
        {
            currentPage = totalPages;
        }
        if (currentPage < 1)
        {
            currentPage = 1;
        }
        
        var skip = (currentPage - 1) * itemsPerPage;
        displayedPastReservations = pastReservations.Skip(skip).Take(itemsPerPage).ToList();
    }
    
    private void GoToPage(int page)
    {
        currentPage = page;
        UpdateDisplayedPastReservations();
    }
    
    private void OnPageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int page))
        {
            GoToPage(page);
        }
    }

    private decimal CalculateAmount(Reservation reservation)
        => reservation.Transactions.Sum(t => t.Montant);

    private decimal CalculateDuration(Reservation reservation)
    {
        var days = (decimal)(reservation.DateFin.Date - reservation.DateDebut.Date).TotalDays + 1;
        return days < 0 ? 0 : days;
    }

    private void ViewReservationClient(int clientId)
    {
        NavigationManager.NavigateTo($"/clients/{clientId}");
    }

    private async Task ShowAddReservationModal()
    {
        reservationError = null;
        newReservation = new ReservationInput
        {
            DateDebut = DateTime.Today,
            DateFin = DateTime.Today.AddDays(1),
            Statut = reservationStatuses.First(),
            ClientId = clients.FirstOrDefault()?.Id.ToString() ?? string.Empty
        };
        selectedTransactionIds = new HashSet<int>();
        showReservationModal = true;
        reservationBeingEdited = null;
        transactionWarningVisible = false;
        await LoadTransactionsForClient(newReservation.ClientId);
    }

    private void CloseReservationModal()
    {
        showReservationModal = false;
        reservationError = null;
        newReservation = new ReservationInput();
        transactionsForClient = new();
        selectedTransactionIds = new HashSet<int>();
        reservationBeingEdited = null;
        transactionWarningVisible = false;
    }

    private async Task SaveReservation()
    {
        reservationError = null;

        if (!int.TryParse(newReservation.ClientId, out var clientId))
        {
            reservationError = "Veuillez sélectionner un client valide.";
            return;
        }

        if (newReservation.DateFin < newReservation.DateDebut)
        {
            reservationError = "La date de fin doit être postérieure ou égale à la date de début.";
            return;
        }

        isSavingReservation = true;

        try
        {
            using var scope = ServiceScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

            var userId = AuthService.GetUtilisateurId();
            if (!userId.HasValue)
            {
                reservationError = "Vous devez être connecté pour enregistrer une réservation.";
                isSavingReservation = false;
                return;
            }

            Reservation reservation;
            if (reservationBeingEdited == null)
            {
                reservation = new Reservation
                {
                    ClientId = clientId,
                    DateDebut = newReservation.DateDebut,
                    DateFin = newReservation.DateFin,
                    Statut = newReservation.Statut,
                    Notes = string.IsNullOrWhiteSpace(newReservation.Notes) ? null : newReservation.Notes.Trim(),
                    DateCreation = DateTime.Now,
                    UtilisateurId = userId.Value
                };

                db.Reservations.Add(reservation);
                await db.SaveChangesAsync();
            }
            else
            {
                reservation = await db.Reservations
                    .Include(r => r.Transactions)
                    .FirstAsync(r => r.Id == reservationBeingEdited.Id);

                // Vérifier que la réservation appartient à l'utilisateur connecté
                if (reservation.UtilisateurId != userId.Value)
                {
                    reservationError = "Vous n'avez pas l'autorisation de modifier cette réservation.";
                    isSavingReservation = false;
                    return;
                }

                reservation.ClientId = clientId;
                reservation.DateDebut = newReservation.DateDebut;
                reservation.DateFin = newReservation.DateFin;
                reservation.Statut = newReservation.Statut;
                reservation.Notes = string.IsNullOrWhiteSpace(newReservation.Notes) ? null : newReservation.Notes.Trim();

                db.Reservations.Update(reservation);
                await db.SaveChangesAsync();

                var transactionsToUpdate = await db.Transactions
                    .Where(t => t.ReservationId == reservation.Id)
                    .ToListAsync();

                foreach (var transaction in transactionsToUpdate)
                {
                    if (!selectedTransactionIds.Contains(transaction.Id))
                    {
                        transaction.ReservationId = null;
                    }
                }
            }

            var transactionsToLink = await db.Transactions
                .Where(t => selectedTransactionIds.Contains(t.Id))
                .ToListAsync();

            foreach (var transaction in transactionsToLink)
            {
                transaction.ReservationId = reservation.Id;
            }

            await db.SaveChangesAsync();

            CloseReservationModal();
            await LoadReservations();
        StateHasChanged();
        }
        catch (Exception ex)
        {
            reservationError = $"Erreur lors de l'enregistrement : {ex.Message}";
        }
        finally
        {
            isSavingReservation = false;
        }
    }

    private async Task LoadTransactionsForClient(string? clientId, IEnumerable<int>? preselected = null)
    {
        transactionsForClient = new();
        selectedTransactionIds = preselected != null ? new HashSet<int>(preselected) : new HashSet<int>();

        if (!int.TryParse(clientId, out var parsedId))
        {
            isLoadingTransactions = false;
            return;
        }

        isLoadingTransactions = true;

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            transactionsForClient = new List<Transaction>();
            isLoadingTransactions = false;
            return;
        }

        var query = db.Transactions
            .Where(t => t.UtilisateurId == userId.Value && t.ClientId == parsedId);

        if (reservationBeingEdited?.Id != null)
        {
            query = query.Where(t => t.ReservationId == null || t.ReservationId == reservationBeingEdited.Id);
        }
        else
        {
            query = query.Where(t => t.ReservationId == null);
        }

        transactionsForClient = await query
            .OrderByDescending(t => t.Date)
            .ToListAsync();

        var availableIds = transactionsForClient.Select(t => t.Id).ToHashSet();
        selectedTransactionIds.IntersectWith(availableIds);

        isLoadingTransactions = false;
    }

    private async Task OnClientChanged(ChangeEventArgs args)
    {
        newReservation.ClientId = args?.Value?.ToString() ?? string.Empty;
        transactionWarningVisible = false;
        await LoadTransactionsForClient(newReservation.ClientId);
    }

    private void ToggleTransactionSelection(int transactionId, ChangeEventArgs args)
    {
        selectedTransactionIds ??= new HashSet<int>();

        var isChecked = args?.Value switch
        {
            bool boolean => boolean,
            string str => str.Equals("on", StringComparison.OrdinalIgnoreCase),
            _ => false
        };

        if (isChecked)
        {
            selectedTransactionIds.Add(transactionId);
        }
        else
        {
            selectedTransactionIds.Remove(transactionId);
        }
    }

    private async Task OnEditReservation(Reservation reservation)
    {
        reservationBeingEdited = reservation;
        newReservation = new ReservationInput
        {
            ClientId = reservation.ClientId.ToString(),
            DateDebut = reservation.DateDebut,
            DateFin = reservation.DateFin,
            Statut = reservation.Statut,
            Notes = reservation.Notes
        };

        var preselected = (reservation.Transactions ?? Enumerable.Empty<Transaction>()).Select(t => t.Id).ToList();
        transactionWarningVisible = preselected.Any();
        showReservationModal = true;

        await LoadTransactionsForClient(newReservation.ClientId, preselected);
    }

    private async Task OnDeleteReservation(Reservation reservation)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Supprimer la réservation #{reservation.Id} ?"))
        {
            return;
        }

        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        var entity = await db.Reservations
            .Include(r => r.Transactions)
            .FirstOrDefaultAsync(r => r.Id == reservation.Id);

        if (entity == null || entity.UtilisateurId != userId.Value)
        {
            return; // Ne pas supprimer si ce n'est pas la réservation de l'utilisateur
        }

        foreach (var transaction in entity.Transactions)
        {
            transaction.ReservationId = null;
        }

        db.Reservations.Remove(entity);
        await db.SaveChangesAsync();

        if (reservationBeingEdited?.Id == reservation.Id)
        {
            CloseReservationModal();
        }

        await LoadReservations();
        StateHasChanged();
    }

    private string GetStatusBadge(string statut)
    {
        return statut switch
        {
            "Confirmée" or "Validée" or "Terminée" => "bg-success",
            "Annulée" or "Refusée" => "bg-danger",
            "En cours" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private string FormatCurrency(decimal value)
        => string.Format(CultureInfo.GetCultureInfo("fr-FR"), "{0:N2} €", value);

    private string FormatDays(decimal value)
    {
        if (value <= 0)
        {
            return "-";
        }

        return value % 1 == 0
            ? string.Format(CultureInfo.GetCultureInfo("fr-FR"), "{0:N0} j", value)
            : string.Format(CultureInfo.GetCultureInfo("fr-FR"), "{0:N1} j", value);
    }

    private class ReservationInput
    {
        [Required(ErrorMessage = "Le client est obligatoire")]
        public string ClientId { get; set; } = string.Empty;

        [Required(ErrorMessage = "La date de début est obligatoire")]
        public DateTime DateDebut { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "La date de fin est obligatoire")]
        public DateTime DateFin { get; set; } = DateTime.Today.AddDays(1);

        [Required(ErrorMessage = "Le statut est obligatoire")]
        public string Statut { get; set; } = "En attente";

        [StringLength(500, ErrorMessage = "Les notes ne peuvent pas dépasser 500 caractères.")]
        public string? Notes { get; set; }
    }
}


