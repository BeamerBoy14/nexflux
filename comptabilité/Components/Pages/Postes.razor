@page "/postes"
@using comptabilité.Models
@using comptabilité.Data
@using comptabilité.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject IServiceScopeFactory ServiceScopeFactory
@inject IJSRuntime JSRuntime
@inject AuthService AuthService
@rendermode InteractiveServer

<PageTitle>Postes de dépense</PageTitle>

<div class="container mt-4 ps-page">
    <div class="ps-header">
        <div>
            <h2 class="ps-title">Postes de dépense</h2>
            <p class="ps-subtitle">@(isLoading ? "Chargement…" : $"{postes.Count} poste{(postes.Count > 1 ? "s" : "")} · {FormatMontant(TotalDepenses)} dépensés")</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> Ajouter un poste
        </button>
    </div>

    @if (isLoading)
    {
        <div class="ps-list ps-list--loading" aria-hidden="true">
            @for (var i = 0; i < 5; i++)
            {
                <div class="ps-skeleton-row">
                    <div class="skeleton-line w-40"></div>
                    <div class="skeleton-line w-60"></div>
                </div>
            }
        </div>
    }
    else if (!postes.Any())
    {
        <div class="ps-empty">
            <i class="bi bi-stack" aria-hidden="true"></i>
            <p class="ps-empty-title">Aucun poste enregistré</p>
            <p>Ajoutez un poste pour organiser vos dépenses.</p>
        </div>
    }
    else
    {
        var principal = PostePrincipal;
        <div class="ps-kpis">
            <div class="ps-kpi">
                <span class="ps-kpi-label">Postes</span>
                <span class="ps-kpi-value">@postes.Count</span>
                <span class="ps-kpi-sub">dont @postes.Count(p => p.PeutAvoirVoiture) associable@(postes.Count(p => p.PeutAvoirVoiture) > 1 ? "s" : "") à une voiture</span>
            </div>
            <div class="ps-kpi ps-kpi--expense">
                <span class="ps-kpi-label">Total dépensé</span>
                <span class="ps-kpi-value">@FormatMontant(TotalDepenses)</span>
                <span class="ps-kpi-sub">@TotalOperations opération@(TotalOperations > 1 ? "s" : "") classée@(TotalOperations > 1 ? "s" : "") dans un poste</span>
            </div>
            <div class="ps-kpi">
                <span class="ps-kpi-label">Poste principal</span>
                <span class="ps-kpi-value ps-kpi-value--text">@(principal?.Nom ?? "-")</span>
                <span class="ps-kpi-sub">@(principal != null ? $"{FormatMontant(StatsDe(principal).Depenses)} · {Part(principal):0} % des dépenses" : "Aucune dépense classée")</span>
            </div>
        </div>

        <div class="ps-toolbar">
            <div class="ps-field ps-field--grow">
                <label for="postes-recherche" class="ps-field-label">Rechercher</label>
                <div class="ps-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="postes-recherche" type="search" class="form-control" placeholder="Nom ou description…"
                           value="@searchText" @oninput="OnSearchInput" />
                </div>
            </div>
            <div class="ps-field">
                <label for="postes-tri" class="ps-field-label">Trier par</label>
                <select id="postes-tri" class="form-select" value="@sortMode" @onchange="OnSortChanged">
                    <option value="nom">Nom (A → Z)</option>
                    <option value="depense">Dépenses (plus élevées d'abord)</option>
                    <option value="operations">Nombre d'opérations</option>
                </select>
            </div>
        </div>

        @if (!FilteredPostes.Any())
        {
            <div class="ps-empty">
                <i class="bi bi-search" aria-hidden="true"></i>
                <p class="ps-empty-title">Aucun résultat</p>
                <p>Aucun poste ne correspond à « @searchText ».</p>
            </div>
        }
        else
        {
            <div class="ps-list">
                <div class="ps-table-wrap">
                    <table class="ps-table">
                        <caption class="visually-hidden">Liste des postes de dépense</caption>
                        <thead>
                            <tr>
                                <th scope="col">Poste</th>
                                <th scope="col" class="ps-col-wide">Voiture</th>
                                <th scope="col" class="ps-col-wide">Opérations</th>
                                <th scope="col" class="ps-col-amount">Dépensé</th>
                                <th scope="col" class="ps-col-actions"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var poste in FilteredPostes)
                            {
                                var stats = StatsDe(poste);
                                <tr>
                                    <td class="ps-col-poste">
                                        <span class="ps-name">@poste.Nom</span>
                                        @if (!string.IsNullOrWhiteSpace(poste.Description))
                                        {
                                            <span class="ps-desc" title="@poste.Description">@poste.Description</span>
                                        }
                                        <span class="ps-inline-meta">
                                            @if (poste.PeutAvoirVoiture)
                                            {
                                                <span class="ps-pill ps-pill--car"><i class="bi bi-car-front-fill" aria-hidden="true"></i>Associable</span>
                                            }
                                            <span class="ps-count">@stats.Count opération@(stats.Count > 1 ? "s" : "")</span>
                                        </span>
                                    </td>
                                    <td class="ps-col-wide">
                                        @if (poste.PeutAvoirVoiture)
                                        {
                                            <span class="ps-pill ps-pill--car"><i class="bi bi-car-front-fill" aria-hidden="true"></i>Associable</span>
                                        }
                                        else
                                        {
                                            <span class="ps-none">Non associable</span>
                                        }
                                    </td>
                                    <td class="ps-col-wide">
                                        <span class="ps-count">@stats.Count</span>
                                        @if (stats.Derniere.HasValue)
                                        {
                                            <small class="ps-last">dernière le @stats.Derniere.Value.ToString("dd/MM/yyyy")</small>
                                        }
                                    </td>
                                    <td class="ps-col-amount">
                                        <span class="ps-amount">@FormatMontant(stats.Depenses)</span>
                                        <span class="ps-share" role="img" aria-label="@Part(poste).ToString("0") % des dépenses">
                                            <span class="ps-share-bar" style="width:@PartBarre(poste)%"></span>
                                        </span>
                                        <small class="ps-last">@Part(poste).ToString("0") %@(stats.Gains > 0 ? $" · +{FormatMontant(stats.Gains)} de gains" : "")</small>
                                    </td>
                                    <td class="ps-col-actions">
                                        <button type="button" class="btn btn-icon btn-outline-primary" @onclick="() => EditPoste(poste)" title="Modifier" aria-label="Modifier @poste.Nom">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="btn btn-icon btn-outline-danger" @onclick="() => DeletePoste(poste)" title="Supprimer" aria-label="Supprimer @poste.Nom">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<!-- Modal -->
@if (showModal)
{
    <div class="modal show d-block modal-backdrop-custom" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-title">@(currentPoste.Id == 0 ? "Ajouter" : "Modifier") un poste</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentPoste" OnValidSubmit="SavePoste">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="postes-champ-1" class="form-label">Nom *</label>
                            <InputText id="postes-champ-1" class="form-control" @bind-Value="currentPoste.Nom" />
                            <ValidationMessage For="@(() => currentPoste.Nom)" />
                        </div>
                        <div class="mb-3">
                            <label for="postes-champ-2" class="form-label">Description</label>
                            <InputTextArea id="postes-champ-2" class="form-control" @bind-Value="currentPoste.Description" rows="3" />
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" @bind="currentPoste.PeutAvoirVoiture" id="peutAvoirVoiture" />
                                <label class="form-check-label" for="peutAvoirVoiture">
                                    Ce poste peut être associé à une voiture
                                </label>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Poste> postes = new();
    private bool showModal = false;
    private Poste currentPoste = new();
    private bool isLoading = true;

    private sealed record PosteStats(int Count, decimal Depenses, decimal Gains, DateTime? Derniere);

    private static readonly PosteStats AucuneStat = new(0, 0m, 0m, null);
    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR");

    private Dictionary<int, PosteStats> stats = new();
    private string searchText = string.Empty;
    private string sortMode = "nom";

    private PosteStats StatsDe(Poste poste) => stats.TryGetValue(poste.Id, out var s) ? s : AucuneStat;

    private decimal TotalDepenses => stats.Values.Sum(s => s.Depenses);

    private int TotalOperations => stats.Values.Sum(s => s.Count);

    private Poste? PostePrincipal => postes
        .Where(p => StatsDe(p).Depenses > 0)
        .OrderByDescending(p => StatsDe(p).Depenses)
        .FirstOrDefault();

    private decimal Part(Poste poste) => TotalDepenses > 0 ? StatsDe(poste).Depenses / TotalDepenses * 100m : 0m;

    private string PartBarre(Poste poste) => Math.Round(Math.Min(100m, Part(poste)), 1).ToString(CultureInfo.InvariantCulture);

    private static string FormatMontant(decimal montant) => $"{montant.ToString("N2", Fr)} €";

    private IEnumerable<Poste> FilteredPostes
    {
        get
        {
            var texte = searchText.Trim();
            var resultat = postes.AsEnumerable();

            if (texte.Length > 0)
            {
                resultat = resultat.Where(p => Contient(p.Nom, texte) || Contient(p.Description, texte));
            }

            return sortMode switch
            {
                "depense" => resultat.OrderByDescending(p => StatsDe(p).Depenses).ThenBy(p => p.Nom),
                "operations" => resultat.OrderByDescending(p => StatsDe(p).Count).ThenBy(p => p.Nom),
                _ => resultat.OrderBy(p => p.Nom, StringComparer.CurrentCultureIgnoreCase)
            };
        }
    }

    private static bool Contient(string? valeur, string texte)
        => valeur != null && Fr.CompareInfo.IndexOf(valeur, texte, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0;

    private void OnSearchInput(ChangeEventArgs e) => searchText = e.Value?.ToString() ?? string.Empty;

    private void OnSortChanged(ChangeEventArgs e) => sortMode = e.Value?.ToString() ?? "nom";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadPostes();
        isLoading = false;
    }

    private async Task LoadPostes()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            postes = new List<Poste>();
            stats = new Dictionary<int, PosteStats>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        postes = await db.Postes
            .Where(p => p.UtilisateurId == userId.Value)
            .OrderBy(p => p.Nom)
            .ToListAsync();

        stats = (await db.Transactions
                .Where(t => t.UtilisateurId == userId.Value && t.PosteId != null)
                .GroupBy(t => t.PosteId!.Value)
                .Select(g => new
                {
                    PosteId = g.Key,
                    Count = g.Count(),
                    Depenses = g.Sum(t => t.Type == "Dépense" ? t.Montant : 0m),
                    Gains = g.Sum(t => t.Type == "Gain" ? t.Montant : 0m),
                    Derniere = g.Max(t => (DateTime?)t.Date)
                })
                .ToListAsync())
            .ToDictionary(x => x.PosteId, x => new PosteStats(x.Count, x.Depenses, x.Gains, x.Derniere));
    }

    private void ShowAddModal()
    {
        currentPoste = new Poste();
        showModal = true;
    }

    private void EditPoste(Poste poste)
    {
        currentPoste = new Poste
        {
            Id = poste.Id,
            Nom = poste.Nom,
            Description = poste.Description,
            PeutAvoirVoiture = poste.PeutAvoirVoiture
        };
        showModal = true;
    }

    private async Task SavePoste()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        if (currentPoste.Id == 0)
        {
            // Nouveau poste : définir l'UtilisateurId
            currentPoste.UtilisateurId = userId.Value;
            db.Postes.Add(currentPoste);
        }
        else
        {
            var existing = await db.Postes.FindAsync(currentPoste.Id);
            if (existing != null)
            {
                // Vérifier que le poste appartient à l'utilisateur connecté
                if (existing.UtilisateurId != userId.Value)
                {
                    return; // Ne pas modifier si ce n'est pas le poste de l'utilisateur
                }
                existing.Nom = currentPoste.Nom;
                existing.Description = currentPoste.Description;
                existing.PeutAvoirVoiture = currentPoste.PeutAvoirVoiture;
                db.Postes.Update(existing);
            }
        }

        await db.SaveChangesAsync();
        CloseModal();
        await LoadPostes();
    }

    private async Task DeletePoste(Poste poste)
    {
        var operations = StatsDe(poste).Count;
        var message = operations > 0
            ? $"Êtes-vous sûr de vouloir supprimer le poste '{poste.Nom}' ?\n\nLes {operations} opération(s) associée(s) seront conservées mais ne seront plus classées dans aucun poste."
            : $"Êtes-vous sûr de vouloir supprimer le poste '{poste.Nom}' ?";

        if (!await JSRuntime.InvokeAsync<bool>("confirm", message))
            return;

        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

        // Vérifier que le poste appartient à l'utilisateur connecté
        var existing = await db.Postes.FindAsync(poste.Id);
        if (existing != null && existing.UtilisateurId != userId.Value)
        {
            return; // Ne pas supprimer si ce n'est pas le poste de l'utilisateur
        }

        db.Postes.Remove(poste);
        await db.SaveChangesAsync();
        await LoadPostes();
    }

    private void CloseModal()
    {
        showModal = false;
        currentPoste = new();
    }
}

