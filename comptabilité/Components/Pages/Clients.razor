@page "/clients"
@using comptabilité.Models
@using comptabilité.Data
@using comptabilité.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject IServiceScopeFactory ServiceScopeFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@rendermode InteractiveServer

<PageTitle>Clients</PageTitle>

<div class="container mt-4 cl-page">
    <div class="cl-header">
        <div>
            <h2 class="cl-title">Clients</h2>
            <p class="cl-subtitle">@(isLoading ? "Chargement…" : $"{clients.Count} client{(clients.Count > 1 ? "s" : "")} enregistré{(clients.Count > 1 ? "s" : "")}")</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> Ajouter un client
        </button>
    </div>

    <div class="cl-toolbar">
        <div class="cl-field cl-field--grow">
            <label for="clients-recherche" class="cl-field-label">Rechercher</label>
            <div class="cl-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="clients-recherche" type="search" class="form-control" placeholder="Nom, e-mail, téléphone, ville, permis…"
                       value="@searchText" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="cl-field">
            <label for="clients-tri" class="cl-field-label">Trier par</label>
            <select id="clients-tri" class="form-select" value="@sortMode" @onchange="OnSortChanged">
                <option value="defaut">ID Tel (récents d'abord)</option>
                <option value="nom">Nom (A → Z)</option>
                <option value="recents">Dernièrement ajoutés</option>
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="cl-list cl-list--loading" aria-hidden="true">
            @for (var i = 0; i < 6; i++)
            {
                <div class="cl-skeleton-row">
                    <div class="skeleton-chip cl-skeleton-avatar"></div>
                    <div class="cl-skeleton-lines">
                        <div class="skeleton-line w-40"></div>
                        <div class="skeleton-line w-60"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!clients.Any())
    {
        <div class="cl-empty">
            <i class="bi bi-people" aria-hidden="true"></i>
            <p class="cl-empty-title">Aucun client enregistré</p>
            <p>Ajoutez votre premier client pour commencer.</p>
        </div>
    }
    else if (!FilteredClients.Any())
    {
        <div class="cl-empty">
            <i class="bi bi-search" aria-hidden="true"></i>
            <p class="cl-empty-title">Aucun résultat</p>
            <p>Aucun client ne correspond à « @searchText ».</p>
        </div>
    }
    else
    {
        <div class="cl-list">
            <div class="cl-table-wrap">
                <table class="cl-table">
                    <caption class="visually-hidden">Liste des clients</caption>
                    <thead>
                        <tr>
                            <th scope="col">Client</th>
                            <th scope="col">Contact</th>
                            <th scope="col" class="cl-col-wide">Localisation</th>
                            <th scope="col" class="cl-col-wide">Pièces</th>
                            <th scope="col" class="cl-col-wide">ID Tel</th>
                            <th scope="col" class="cl-col-actions"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in displayedClients)
                        {
                            <tr @onclick="() => ViewDetails(client.Id)">
                                <td class="cl-col-client">
                                    <div class="cl-client-cell">
                                        <span class="cl-avatar" aria-hidden="true">@Initials(client)</span>
                                        <span class="cl-identity">
                                            <a class="cl-name" href="/clients/@client.Id" @onclick:stopPropagation="true">@FormatFullName(client)</a>
                                            <small>Client depuis @FormatCreationDate(client.DateCreation)</small>
                                        </span>
                                    </div>
                                </td>
                                <td class="cl-col-contact">
                                    @if (!string.IsNullOrWhiteSpace(client.Email))
                                    {
                                        <span class="cl-line"><i class="bi bi-envelope" aria-hidden="true"></i>@client.Email</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(client.Telephone))
                                    {
                                        <span class="cl-line"><i class="bi bi-telephone" aria-hidden="true"></i>@client.Telephone</span>
                                    }
                                </td>
                                <td class="cl-col-wide">
                                    @if (!string.IsNullOrWhiteSpace(client.Ville) || !string.IsNullOrWhiteSpace(client.CodePostal))
                                    {
                                        <span class="cl-line"><i class="bi bi-geo-alt" aria-hidden="true"></i>@($"{client.Ville} {client.CodePostal}".Trim())</span>
                                    }
                                    else
                                    {
                                        <span class="cl-none">-</span>
                                    }
                                </td>
                                <td class="cl-col-wide">
                                    <span class="cl-line"><span class="cl-key">ID</span>@FormatValue(client.NumeroIdd)</span>
                                    <span class="cl-line"><span class="cl-key">Permis</span>@FormatValue(client.NumeroPermis)</span>
                                </td>
                                <td class="cl-col-wide">
                                    @if (!string.IsNullOrWhiteSpace(client.IdTel))
                                    {
                                        <span class="cl-chip">@client.IdTel</span>
                                    }
                                    else
                                    {
                                        <span class="cl-none">-</span>
                                    }
                                </td>
                                <td class="cl-col-actions">
                                    <button type="button" class="btn btn-icon btn-outline-primary" @onclick="() => EditClient(client)" @onclick:stopPropagation="true" title="Modifier" aria-label="Modifier @client.Nom">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-outline-danger" @onclick="() => DeleteClient(client)" @onclick:stopPropagation="true" title="Supprimer" aria-label="Supprimer @client.Nom">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav class="cl-pager" aria-label="Pagination des clients">
                    <span class="cl-pager-info">@RangeLabel</span>
                    <div class="cl-pager-buttons">
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="PreviousPage" disabled="@(currentPage <= 1)" aria-label="Page précédente">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </button>
                        <span class="cl-pager-page">Page @currentPage / @totalPages</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="NextPage" disabled="@(currentPage >= totalPages)" aria-label="Page suivante">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </nav>
            }
        </div>
    }
</div>

<!-- Modal -->
@if (showModal)
{
    <div class="modal show d-block modal-backdrop-custom" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-title">@(currentClient.Id == 0 ? "Ajouter" : "Modifier") un client</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mb-3" role="alert">
                            @errorMessage
                        </div>
                    }
                    <EditForm Model="currentClient" OnValidSubmit="SaveClient">
                        <DataAnnotationsValidator />
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="clients-champ-2" class="form-label">Nom *</label>
                                <InputText id="clients-champ-2" class="form-control" @bind-Value="currentClient.Nom" />
                                <ValidationMessage For="@(() => currentClient.Nom)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="clients-champ-3" class="form-label">Prénom</label>
                                <InputText id="clients-champ-3" class="form-control" @bind-Value="currentClient.Prenom" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="clients-champ-4" class="form-label">Email *</label>
                            <InputText id="clients-champ-4" type="email" class="form-control" @bind-Value="currentClient.Email" />
                            <ValidationMessage For="@(() => currentClient.Email)" />
                        </div>
                        <div class="mb-3">
                            <label for="clients-champ-5" class="form-label">Téléphone</label>
                            <InputText id="clients-champ-5" class="form-control" @bind-Value="currentClient.Telephone" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="clients-champ-6" class="form-label">Numéro ID</label>
                                <InputText id="clients-champ-6" class="form-control" @bind-Value="currentClient.NumeroIdd" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="clients-champ-7" class="form-label">Numéro Permis</label>
                                <InputText id="clients-champ-7" class="form-control" @bind-Value="currentClient.NumeroPermis" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="clients-champ-8" class="form-label">Date de Naissance</label>
                                <InputDate id="clients-champ-8" class="form-control" @bind-Value="currentClient.DateNaissance" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="clients-champ-9" class="form-label">ID Tel</label>
                                <InputText id="clients-champ-9" class="form-control" @bind-Value="currentClient.IdTel" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="clients-champ-10" class="form-label">Adresse</label>
                            <InputText id="clients-champ-10" class="form-control" @bind-Value="currentClient.Adresse" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="clients-champ-11" class="form-label">Code Postal</label>
                                <InputText id="clients-champ-11" class="form-control" @bind-Value="currentClient.CodePostal" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="clients-champ-12" class="form-label">Ville</label>
                                <InputText id="clients-champ-12" class="form-control" @bind-Value="currentClient.Ville" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Client> clients = new();
    private List<Client> displayedClients = new();
    private bool showModal = false;
    private Client currentClient = new();
    private string? errorMessage = null;
    private bool isLoading = true;
    private int currentPage = 1;
    private const int ItemsPerPage = 12;
    private int totalPages = 1;
    private string searchText = string.Empty;
    private string sortMode = "defaut";
    private List<Client> filteredClients = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await LoadClients();
        isLoading = false;
    }

    private async Task LoadClients()
    {
        var userId = AuthService.GetUtilisateurId();
        if (!userId.HasValue)
        {
            clients = new List<Client>();
            return;
        }

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        clients = await db.Clients
            .Where(c => c.UtilisateurId == userId.Value)
            .OrderByDescending(c => c.IdTel) // Ordre inverse de l'IdTel (décroissant)
            .ThenBy(c => string.IsNullOrWhiteSpace(c.IdTel) ? 1 : 0) // Les vides en dernier
            .ThenBy(c => c.Nom)
            .ThenBy(c => c.Prenom)
            .ToListAsync();
        
        UpdateDisplayedClients();
    }
    
    private void UpdateDisplayedClients()
    {
        var texte = searchText.Trim();
        IEnumerable<Client> resultat = clients;

        if (texte.Length > 0)
        {
            resultat = resultat.Where(c =>
                Contient(c.Nom, texte) || Contient(c.Prenom, texte) || Contient(c.Email, texte) ||
                Contient(c.Telephone, texte) || Contient(c.Ville, texte) || Contient(c.CodePostal, texte) ||
                Contient(c.NumeroIdd, texte) || Contient(c.NumeroPermis, texte) || Contient(c.IdTel, texte));
        }

        resultat = sortMode switch
        {
            "nom" => resultat.OrderBy(c => c.Nom, StringComparer.CurrentCultureIgnoreCase).ThenBy(c => c.Prenom),
            "recents" => resultat.OrderByDescending(c => c.DateCreation).ThenByDescending(c => c.Id),
            _ => resultat
        };

        filteredClients = resultat.ToList();
        totalPages = Math.Max(1, (int)Math.Ceiling((double)filteredClients.Count / ItemsPerPage));
        currentPage = Math.Clamp(currentPage, 1, totalPages);
        displayedClients = filteredClients.Skip((currentPage - 1) * ItemsPerPage).Take(ItemsPerPage).ToList();
    }

    private IEnumerable<Client> FilteredClients => filteredClients;

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        UpdateDisplayedClients();
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        sortMode = e.Value?.ToString() ?? "defaut";
        currentPage = 1;
        UpdateDisplayedClients();
    }

    private static bool Contient(string? valeur, string texte)
        => valeur != null && CultureInfo.GetCultureInfo("fr-FR").CompareInfo.IndexOf(valeur, texte, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0;

    private string RangeLabel
    {
        get
        {
            var debut = (currentPage - 1) * ItemsPerPage + 1;
            var fin = Math.Min(currentPage * ItemsPerPage, filteredClients.Count);
            return $"{debut}–{fin} sur {filteredClients.Count} client{(filteredClients.Count > 1 ? "s" : "")}";
        }
    }

    private static string Initials(Client client)
    {
        var lettres = new[] { client.Prenom, client.Nom }
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => char.ToUpperInvariant(v!.Trim()[0]));
        var resultat = string.Concat(lettres);
        return resultat.Length > 0 ? resultat : "?";
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            UpdateDisplayedClients();
        }
    }
    
    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdateDisplayedClients();
        }
    }

    private void ShowAddModal()
    {
        currentClient = new Client
        {
            DateCreation = DateTime.Now
        };
        errorMessage = null;
        showModal = true;
    }

    private void EditClient(Client client)
    {
        currentClient = new Client
        {
            Id = client.Id,
            Nom = client.Nom,
            Prenom = client.Prenom,
            Email = client.Email,
            Telephone = client.Telephone,
            Adresse = client.Adresse,
            CodePostal = client.CodePostal,
            Ville = client.Ville,
            NumeroIdd = client.NumeroIdd,
            NumeroPermis = client.NumeroPermis,
            DateNaissance = client.DateNaissance,
            IdTel = client.IdTel,
            DateCreation = client.DateCreation
        };
        errorMessage = null;
        showModal = true;
    }

    private async Task SaveClient()
    {
        errorMessage = null;
        try
        {
            using var scope = ServiceScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();

            // S'assurer que DateCreation est défini pour les nouveaux clients
            if (currentClient.Id == 0)
            {
                if (currentClient.DateCreation == default)
                {
                    currentClient.DateCreation = DateTime.Now;
                }
                // Assigner l'utilisateur connecté au nouveau client
                var userId = AuthService.GetUtilisateurId();
                if (userId.HasValue)
                {
                    currentClient.UtilisateurId = userId.Value;
                }
                db.Clients.Add(currentClient);
            }
            else
            {
                var existing = await db.Clients.FindAsync(currentClient.Id);
                if (existing != null)
                {
                    // Vérifier que le client appartient à l'utilisateur connecté
                    var userId = AuthService.GetUtilisateurId();
                    if (userId.HasValue && existing.UtilisateurId != userId.Value)
                    {
                        errorMessage = "Vous n'avez pas l'autorisation de modifier ce client.";
                        StateHasChanged();
                        return;
                    }
                    
                    existing.Nom = currentClient.Nom;
                    existing.Prenom = currentClient.Prenom;
                    existing.Email = currentClient.Email;
                    existing.Telephone = currentClient.Telephone;
                    existing.Adresse = currentClient.Adresse;
                    existing.CodePostal = currentClient.CodePostal;
                    existing.Ville = currentClient.Ville;
                    existing.NumeroIdd = currentClient.NumeroIdd;
                    existing.NumeroPermis = currentClient.NumeroPermis;
                    existing.DateNaissance = currentClient.DateNaissance;
                    existing.IdTel = currentClient.IdTel;
                    db.Clients.Update(existing);
                }
            }

            await db.SaveChangesAsync();
            errorMessage = null;
            CloseModal();
            await LoadClients();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Afficher l'erreur dans l'interface
            errorMessage = $"Erreur lors de la sauvegarde : {ex.Message}";
            if (ex.InnerException != null)
            {
                errorMessage += $" ({ex.InnerException.Message})";
            }
            Console.WriteLine($"Erreur lors de la sauvegarde du client: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            StateHasChanged();
        }
    }

    private async Task DeleteClient(Client client)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer le client '{client.Nom} {client.Prenom}' ?"))
            return;

        using var scope = ServiceScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ComptabiliteDbContext>();
        db.Clients.Remove(client);
        await db.SaveChangesAsync();
        await LoadClients();
    }

    private void CloseModal()
    {
        showModal = false;
        currentClient = new();
        errorMessage = null;
    }

    private void ViewDetails(int clientId)
    {
        NavigationManager.NavigateTo($"/clients/{clientId}");
    }

    private string FormatValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";

    private string FormatCreationDate(DateTime value) => value.ToString("dd MMMM yyyy", CultureInfo.GetCultureInfo("fr-FR"));

    private string FormatFullName(Client client) =>
        string.IsNullOrWhiteSpace(client.Prenom)
            ? client.Nom
            : $"{client.Nom} {client.Prenom}";
}

