<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="css/base.css" />
    <link rel="stylesheet" href="css/navigation.css" />
    <link rel="stylesheet" href="css/components.css" />
    <link rel="stylesheet" href="css/tables.css" />
    <link rel="stylesheet" href="css/transactions.css" />
    <link rel="stylesheet" href="css/skeleton.css" />
    <link rel="stylesheet" href="css/clients.css" />
    <link rel="stylesheet" href="css/reservations.css" />
    <link rel="stylesheet" href="css/voitures.css" />
    <link rel="stylesheet" href="css/widgets.css" />
    <link rel="stylesheet" href="css/text-controls.css" />
    <link rel="stylesheet" href="css/layout.css" />
    <link rel="stylesheet" href="css/home.css" />
    <link rel="stylesheet" href="NexFlux.styles.css" />
    <link rel="stylesheet" href="css/accessibility.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    <script>
        // Écran de chargement : défini dans le <head> pour n'être exécuté
        // qu'aux chargements complets de page (pas lors des navigations SPA).
        window.__showSplash = function (text) {
            if (document.getElementById('app-loading')) return;
            var o = document.createElement('div');
            o.id = 'app-loading';
            o.className = 'app-loading';
            o.innerHTML =
                '<div class="app-loading__spinner"></div>' +
                '<div class="app-loading__logo"><span class="gradient-text">NEX</span><span class="gradient-text-accent">FLUX</span></div>' +
                '<div class="app-loading__text">' + (text || 'Chargement') + '<span class="app-loading__dots"></span></div>';
            (document.body || document.documentElement).appendChild(o);
        };
        window.__hideSplash = function () {
            var el = document.getElementById('app-loading');
            if (!el) return;
            el.classList.add('app-loading--hidden');
            setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 600);
        };
        // Affiché immédiatement au chargement initial du document.
        window.__showSplash();
    </script>
</head>

<body class="bg-dark text-light">
    <Routes />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="js/cleanup-cookies.js"></script>
    <script src="js/auth.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        (function () {
            // Sécurité : masque l'écran de chargement au bout de 10 s même si Blazor n'a pas démarré
            var safety = setTimeout(window.__hideSplash, 10000);

            Blazor.start().then(function () {
                clearTimeout(safety);
                window.__hideSplash();
            }).catch(function () {
                clearTimeout(safety);
                window.__hideSplash();
            });
        })();
    </script>
    <script src="js/charts.js"></script>
</body>

</html>
