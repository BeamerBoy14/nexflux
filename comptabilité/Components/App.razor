<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css?v=@AssetVersion" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="css/base.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/navigation.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/components.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/tables.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/transactions.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/skeleton.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/clients.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/reservations.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/voitures.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/widgets.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/text-controls.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/layout.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/home.css?v=@AssetVersion" />
    <link rel="stylesheet" href="NexFlux.styles.css?v=@AssetVersion" />
    <link rel="stylesheet" href="css/accessibility.css?v=@AssetVersion" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="64x64" href="favicon.png?v=2" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png?v=2" />
    <meta name="theme-color" content="#000011" />
    <HeadOutlet />
    <script>
        // Écran de chargement : défini dans le <head> pour n'être exécuté
        // qu'aux chargements complets de page (pas lors des navigations SPA).
        window.__showSplash = function (text) {
            if (document.getElementById('app-loading')) return;
            var o = document.createElement('div');
            o.id = 'app-loading';
            o.className = 'app-loading';
            o.innerHTML =
                '<div class="app-loading__spinner"></div>' +
                '<div class="app-loading__logo"><span class="gradient-text">NEX</span><span class="gradient-text-accent">FLUX</span></div>' +
                '<div class="app-loading__text">' + (text || 'Chargement') + '<span class="app-loading__dots"></span></div>';
            (document.body || document.documentElement).appendChild(o);
        };
        window.__hideSplash = function () {
            var el = document.getElementById('app-loading');
            if (!el) return;
            el.classList.add('app-loading--hidden');
            setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 600);
        };
        // Affiché immédiatement au chargement initial du document.
        window.__showSplash();
    </script>
</head>

<body class="bg-dark text-light">
    <Routes />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="js/cleanup-cookies.js?v=@AssetVersion"></script>
    <script src="js/auth.js?v=@AssetVersion"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        (function () {
            // Sécurité : masque l'écran de chargement au bout de 10 s même si Blazor n'a pas démarré
            var safety = setTimeout(window.__hideSplash, 10000);

            Blazor.start().then(function () {
                clearTimeout(safety);
                window.__hideSplash();
            }).catch(function () {
                clearTimeout(safety);
                window.__hideSplash();
            });
        })();
    </script>
    <script src="js/charts.js?v=@AssetVersion"></script>
</body>

</html>

@code {
    // Les feuilles de style et scripts locaux ne sont pas empreints par le framework : sans ce paramètre,
    // un navigateur peut garder l'ancienne version après un déploiement (mise en page cassée jusqu'à Ctrl+F5).
    // La valeur change à chaque nouvelle compilation, donc à chaque nouvelle image Docker.
    private static readonly string AssetVersion = ComputeAssetVersion();

    private static string ComputeAssetVersion()
    {
        try
        {
            return File.GetLastWriteTimeUtc(typeof(App).Assembly.Location).Ticks.ToString("x");
        }
        catch
        {
            return "0";
        }
    }
}
